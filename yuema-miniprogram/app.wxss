view, scroll-view, text, button, input {
  box-sizing: border-box;
}

/**
 * 页面级仅保留与主题无关的基础排版；主题色与渐变在 .theme-scope 上定义，
 * 便于在个人中心切换浅色 / 深色（见 utils/theme.js + behaviors/themeBehavior.js）。
 */
page {
  --font-display: 'Poppins', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  --font-body: 'Lora', 'Noto Serif SC', 'Songti SC', 'PingFang SC', serif;
  /* 动效：ease-out，避免弹性；时长与 skill 建议的 150–300ms 对齐 */
  --ease-out: cubic-bezier(0.25, 0.1, 0.25, 1);
  --duration: 220ms;
  height: 100%;
  font-family: var(--font-body);
  font-size: 28rpx;
  line-height: 1.55;
  letter-spacing: 0.2rpx;
  background-color: transparent;
  /* 全局：隐藏页面级纵向滚动条（保留滚动）；与下方 scroll-view 规则覆盖各 tab 页 */
  scrollbar-width: none;
  -ms-overflow-style: none;
}

/* 全局：WebKit 内核下隐藏页面滚动条轨道（真机/开发者工具因系统绘制可能略有差异） */
page::-webkit-scrollbar {
  width: 0 !important;
  height: 0 !important;
  display: none !important;
  background: transparent;
}

/* 全局：scroll-view 滚动条；WXML 须 show-scrollbar="{{false}}" 且 WebView 下须 enhanced="{{true}}" 才生效（见官方 scroll-view 说明） */
scroll-view {
  scrollbar-width: none;
  -ms-overflow-style: none;
}

scroll-view::-webkit-scrollbar {
  width: 0 !important;
  height: 0 !important;
  display: none !important;
  background: transparent;
}

/* 补全 WebKit 轨道/滑块/角落：部分内核仅隐藏 ::-webkit-scrollbar 仍会露出细灰条；scroll-view 须在 WXML 写 enhanced + show-scrollbar="{{false}}"（WebView 官方要求） */
page::-webkit-scrollbar-track,
page::-webkit-scrollbar-thumb,
page::-webkit-scrollbar-corner,
scroll-view::-webkit-scrollbar-track,
scroll-view::-webkit-scrollbar-thumb,
scroll-view::-webkit-scrollbar-corner {
  width: 0 !important;
  height: 0 !important;
  display: none !important;
  background: transparent;
}

.font-display {
  font-family: var(--font-display);
}

/* ---- 浅色主题（与改版前 page 令牌一致）---- */
.theme-scope {
  --bg: #faf9f5;
  --bg-soft: #f3f1ea;
  --bg-muted: #e8e6dc;
  --text: #141413;
  --text-secondary: #b0aea5;
  --accent-orange: #d97757;
  --accent-orange-soft: rgba(217, 119, 87, 0.12);
  --accent-orange-border: rgba(217, 119, 87, 0.35);
  --accent-blue: #6a9bcc;
  --accent-green: #788c5d;
  --surface: rgba(255, 255, 255, 0.92);
  --surface-solid: #fffefb;
  --border: rgba(20, 20, 19, 0.08);
  --shadow: 0 12rpx 48rpx rgba(20, 20, 19, 0.08);
  --shadow-sm: 0 6rpx 24rpx rgba(20, 20, 19, 0.06);
  --list-row: rgba(255, 255, 255, 0.72);
  --tag-primary-bg: rgba(217, 119, 87, 0.12);
  --tag-primary-fg: #c45a3d;
  --tag-warning-bg: rgba(255, 171, 0, 0.12);
  --tag-warning-fg: #c97800;
  --avatar-gradient-end: #dcd8cc;
  --btn-primary-text: #fffefb;
  --btn-primary-shadow: rgba(217, 119, 87, 0.35);
  --danger: #cf1322;

  min-height: 100%;
  width: 100%;
  box-sizing: border-box;
  font-family: var(--font-body);
  color: var(--text);
  background-color: var(--bg);
  background-image: linear-gradient(180deg, #fdfcfa 0%, var(--bg) 35%, var(--bg-soft) 100%);
  /* 整页滚动若落在根 view 而非 page 时，与 page 一致隐藏滚动条（非滚动容器时不生效） */
  scrollbar-width: none;
  -ms-overflow-style: none;
}

/* 与 page/scroll-view 同策略：根层成为滚动容器时隐藏 WebKit 滚动条 */
.theme-scope::-webkit-scrollbar,
.theme-scope::-webkit-scrollbar-track,
.theme-scope::-webkit-scrollbar-thumb,
.theme-scope::-webkit-scrollbar-corner {
  width: 0 !important;
  height: 0 !important;
  display: none !important;
  background: transparent;
}

/* Tab 整页：page 上滚动条在部分 WebView 无法去掉，改为内层滚动容器；首页用 scroll-view 见 pages/index */
.page-native-scroll-host {
  height: 100%;
  overflow: hidden;
  box-sizing: border-box;
}

.page-native-scroll-body {
  height: 100%;
  overflow-x: hidden;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.page-native-scroll-body::-webkit-scrollbar,
.page-native-scroll-body::-webkit-scrollbar-track,
.page-native-scroll-body::-webkit-scrollbar-thumb,
.page-native-scroll-body::-webkit-scrollbar-corner {
  width: 0 !important;
  height: 0 !important;
  display: none !important;
  background: transparent;
}

/* ---- 深色主题：暖灰炭底 + 同色相配强调（略提亮橙）---- */
/* 深色卡片上的「删除」：避免浅粉底与炭底反差刺眼，略压饱和度 */
.theme-scope--dark .room-danger-btn,
.theme-scope--dark .owner-btn-danger {
  background: rgba(248, 113, 113, 0.16) !important;
  border-color: rgba(248, 113, 113, 0.42) !important;
}

.theme-scope--dark {
  --bg: #1c1c1a;
  --bg-soft: #242422;
  --bg-muted: #32322f;
  --text: #ebe9e3;
  --text-secondary: #9c9a93;
  --accent-orange: #e89572;
  --accent-orange-soft: rgba(232, 149, 114, 0.16);
  --accent-orange-border: rgba(232, 149, 114, 0.42);
  --accent-blue: #7eb0d4;
  --accent-green: #92ab74;
  --surface: rgba(44, 44, 42, 0.94);
  --surface-solid: #2c2c2a;
  --border: rgba(235, 233, 227, 0.09);
  --shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.34);
  --shadow-sm: 0 6rpx 24rpx rgba(0, 0, 0, 0.22);
  --list-row: rgba(255, 255, 255, 0.05);
  --tag-primary-bg: rgba(232, 149, 114, 0.18);
  --tag-primary-fg: #f0c4b0;
  --tag-warning-bg: rgba(255, 186, 66, 0.14);
  --tag-warning-fg: #e8b86a;
  --avatar-gradient-end: #454540;
  --btn-primary-text: #fffefb;
  --btn-primary-shadow: rgba(232, 149, 114, 0.28);
  --danger: #f87171;

  background-image: linear-gradient(180deg, #262624 0%, var(--bg) 40%, #181816 100%);
}

.theme-scope scroll-view {
  background-color: transparent;
}

/* 通用容器 */
.container {
  padding: 32rpx;
  padding-bottom: 40rpx;
}

/* 页面渐变定义在外层 .theme-scope；内层 container 勿铺纯色盖住背景 */
.theme-scope > .container {
  background-color: transparent;
}

/* ---- 卡片 ---- */
.card {
  background: var(--surface);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border);
  box-shadow: var(--shadow);
  transition: opacity var(--duration) var(--ease-out), transform var(--duration) var(--ease-out),
    box-shadow var(--duration) var(--ease-out);
}

.card.surface-press:active {
  opacity: 0.94;
  transform: translateY(2rpx);
  box-shadow: var(--shadow-sm);
}

/* ---- 按钮 ---- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  transition: opacity var(--duration) var(--ease-out), transform var(--duration) var(--ease-out);
}

.btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(145deg, #e08568 0%, #d97757 48%, #c96a4d 100%);
  color: var(--btn-primary-text);
  box-shadow: 0 8rpx 28rpx var(--btn-primary-shadow);
}

.theme-scope--dark .btn-primary {
  background: linear-gradient(145deg, #f0a080 0%, #e89572 48%, #d98462 100%);
}

.btn-primary:active {
  opacity: 0.88;
  transform: translateY(2rpx);
}

.btn-secondary {
  background: var(--surface-solid);
  color: var(--text);
  border: 1rpx solid var(--border);
  box-shadow: var(--shadow-sm);
}

.btn-secondary:active {
  background: var(--bg-muted);
}

/* ---- 输入框 ---- */
.input {
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--surface-solid);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--text);
  border: 1rpx solid var(--border);
}

.input-placeholder {
  color: var(--text-secondary);
}

/* ---- 列表行 ---- */
.list-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: var(--list-row);
  border-bottom: 1rpx solid var(--border);
}

/* ---- 标签 ---- */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.tag-primary {
  background: var(--tag-primary-bg);
  color: var(--tag-primary-fg);
}

.tag-warning {
  background: var(--tag-warning-bg);
  color: var(--tag-warning-fg);
}

/* ---- 文本语义色 ---- */
.text-primary {
  color: var(--accent-orange);
}

.text-secondary {
  color: var(--text-secondary);
}

/* ---- Section 标题 ---- */
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 32rpx;
  letter-spacing: 0.5rpx;
}

/* ---- 头像占位 ---- */
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 14rpx;
  background: linear-gradient(145deg, var(--bg-muted) 0%, var(--avatar-gradient-end) 100%);
  border: 1rpx solid var(--border);
}

/* ---- 底部安全区域 ---- */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
