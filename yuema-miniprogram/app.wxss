/* ========================================
   约麻小程序 - SOLO 风格全局样式
   深色主题 + 现代简洁 + 圆角卡片
   ======================================== */

page {
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  background-color: #0f0f0f;
  color: #e8e8e8;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 通用容器 */
.container {
  padding: 24rpx;
  padding-bottom: 40rpx;
}

/* ---- 卡片样式 ---- */
.card {
  background: #1a1a1a;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

/* ---- 按钮样式 ---- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  border: none;
  transition: all 0.2s ease;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #6C5CE7 0%, #a855f7 100%);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(108, 92, 231, 0.3);
}

.btn-primary:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.btn-primary.disabled {
  opacity: 0.4;
  box-shadow: none;
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.08);
  color: #e8e8e8;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.btn-secondary:active {
  background: rgba(255, 255, 255, 0.12);
}

.btn-danger {
  background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(231, 76, 60, 0.3);
}

.btn-danger:active {
  opacity: 0.85;
}

/* ---- 输入框样式 ---- */
.input {
  height: 96rpx;
  padding: 0 32rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 48rpx;
  font-size: 28rpx;
  color: #e8e8e8;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

/* ---- 列表样式 ---- */
.list-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: #1a1a1a;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.04);
}

.list-item:last-child {
  border-bottom: none;
}

/* ---- 标签样式 ---- */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-primary {
  background: rgba(108, 92, 231, 0.15);
  color: #a78bfa;
}

.tag-warning {
  background: rgba(250, 173, 20, 0.15);
  color: #fbbf24;
}

.tag-danger {
  background: rgba(231, 76, 60, 0.15);
  color: #f87171;
}

/* ---- 文本样式 ---- */
.text-primary {
  color: #a78bfa;
}

.text-secondary {
  color: rgba(255, 255, 255, 0.4);
}

.text-danger {
  color: #f87171;
}

.text-accent {
  color: #6C5CE7;
}

/* ---- 布局工具类 ---- */
.flex {
  display: flex;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.mt-20 { margin-top: 20rpx; }
.mb-20 { margin-bottom: 20rpx; }
.ml-20 { margin-left: 20rpx; }
.mr-20 { margin-right: 20rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-32 { margin-bottom: 32rpx; }

/* ---- 分割线 ---- */
.divider {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.06);
  margin: 24rpx 0;
}

/* ---- Section 标题 ---- */
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 24rpx;
}

.section-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-bottom: 24rpx;
}

/* ---- 空状态 ---- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.3;
}

.empty-state text {
  color: rgba(255, 255, 255, 0.3);
  font-size: 28rpx;
}

/* ---- 头像 ---- */
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.avatar-sm {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.avatar-lg {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

/* ---- 徽章/气泡 ---- */
.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 10rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.badge-accent {
  background: #6C5CE7;
  color: #fff;
}

.badge-success {
  background: rgba(16, 185, 129, 0.2);
  color: #34d399;
}

.badge-warning {
  background: rgba(250, 173, 20, 0.2);
  color: #fbbf24;
}

/* ---- 底部安全区域 ---- */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
