view, scroll-view, text, button, input {
  box-sizing: border-box;
}

page {
  font-family: Inter, -apple-system, BlinkMacSystemFont, 'SF Pro Display', sans-serif;
  background-color: #000000;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 1.5;
}

/* Trae Solo 颜色变量 */
/* --primary: #28E088; --surface: #101214; --border: #1F1F1F; */

/* 通用容器 */
.container {
  padding: 32rpx;
  padding-bottom: 40rpx;
}

/* ---- 卡片样式 (Trae 风格) ---- */
.card {
  background: #101214;
  border-radius: 12rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #1F1F1F;
}

/* ---- 按钮样式 (Trae 风格) ---- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.btn::after {
  border: none;
}

.btn-primary {
  background: #28E088;
  color: #000000;
}

.btn-primary:active {
  opacity: 0.8;
  transform: translateY(2rpx);
}

.btn-secondary {
  background: #101214;
  color: #ffffff;
  border: 1rpx solid #1F1F1F;
}

.btn-secondary:active {
  background: #1A1D21;
}

/* ---- 输入框样式 ---- */
.input {
  height: 88rpx;
  padding: 0 24rpx;
  background: #000000;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #ffffff;
  border: 1rpx solid #1F1F1F;
}

.input-placeholder {
  color: #4B4B4B;
}

/* ---- 列表样式 ---- */
.list-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: #101214;
  border-bottom: 1rpx solid #1F1F1F;
}

/* ---- 标签样式 ---- */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.tag-primary {
  background: rgba(40, 224, 136, 0.1);
  color: #28E088;
}

.tag-warning {
  background: rgba(255, 171, 0, 0.1);
  color: #FFAB00;
}

/* ---- 文本样式 ---- */
.text-primary {
  color: #28E088;
}

.text-secondary {
  color: #8A9096;
}

/* ---- Section 标题 ---- */
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 32rpx;
  letter-spacing: -0.5rpx;
}

/* ---- 头像 ---- */
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  background: #1F1F1F;
}

/* ---- 底部安全区域 ---- */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
