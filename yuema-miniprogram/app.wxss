view, scroll-view, text, button, input {
  box-sizing: border-box;
}

/* scroll-view 默认易透出白底；转场/下拉刷新时尤其明显 */
scroll-view {
  background-color: #08090A;
}

page {
  height: 100%;
  font-family: 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Noto Sans SC', -apple-system, BlinkMacSystemFont, sans-serif;
  background-color: #08090A;
  background-image: linear-gradient(180deg, #0e1014 0%, #08090A 28%, #060708 100%);
  color: #f4f5f7;
  font-size: 28rpx;
  line-height: 1.55;
  letter-spacing: 0.2rpx;
}

/* 品牌色：略降低饱和度，大面积更易衬出质感 */
/* accent ~ #32d8a8 | surface #13161c */

/* 通用容器 */
.container {
  padding: 32rpx;
  padding-bottom: 40rpx;
}

/* ---- 卡片样式 (Trae 风格) ---- */
.card {
  background: rgba(19, 22, 28, 0.92);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.055);
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.38);
}

/* ---- 按钮样式 (Trae 风格) ---- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(145deg, #3ae8b0 0%, #28c993 48%, #22b882 100%);
  color: #061210;
  box-shadow: 0 8rpx 24rpx rgba(40, 201, 147, 0.22);
}

.btn-primary:active {
  opacity: 0.8;
  transform: translateY(2rpx);
}

.btn-secondary {
  background: rgba(19, 22, 28, 0.85);
  color: #f4f5f7;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.btn-secondary:active {
  background: rgba(28, 32, 40, 0.95);
}

/* ---- 输入框样式 ---- */
.input {
  height: 88rpx;
  padding: 0 24rpx;
  background: #000000;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #ffffff;
  border: 1rpx solid #1F1F1F;
}

.input-placeholder {
  color: #4B4B4B;
}

/* ---- 列表样式 ---- */
.list-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: rgba(19, 22, 28, 0.6);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

/* ---- 标签样式 ---- */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.tag-primary {
  background: rgba(50, 216, 168, 0.12);
  color: #4ae8b8;
}

.tag-warning {
  background: rgba(255, 171, 0, 0.1);
  color: #FFAB00;
}

/* ---- 文本样式 ---- */
.text-primary {
  color: #4ae8b8;
}

.text-secondary {
  color: #8A9096;
}

/* ---- Section 标题 ---- */
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #f4f5f7;
  margin-bottom: 32rpx;
  letter-spacing: 0.5rpx;
}

/* ---- 头像 ---- */
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 14rpx;
  background: linear-gradient(145deg, #1e232c 0%, #141820 100%);
}

/* ---- 底部安全区域 ---- */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
