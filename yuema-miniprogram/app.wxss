view, scroll-view, text, button, input {
  box-sizing: border-box;
}

/* Anthropic 风格浅色令牌：集中定义便于全站一致 */
page {
  --bg: #faf9f5;
  --bg-soft: #f3f1ea;
  --bg-muted: #e8e6dc;
  --text: #141413;
  --text-secondary: #b0aea5;
  --accent-orange: #d97757;
  --accent-blue: #6a9bcc;
  --accent-green: #788c5d;
  --surface: rgba(255, 255, 255, 0.92);
  --surface-solid: #ffffff;
  --border: rgba(20, 20, 19, 0.08);
  --shadow: 0 12rpx 48rpx rgba(20, 20, 19, 0.08);
  --shadow-sm: 0 6rpx 24rpx rgba(20, 20, 19, 0.06);
  /* loadFontFace 成功前回退系统字体；标题区可用 font-display / font-body 类 */
  --font-display: 'Poppins', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  --font-body: 'Lora', 'Noto Serif SC', 'Songti SC', 'PingFang SC', serif;
}

/* scroll-view 与页面页底一致，避免下拉刷新露异色 */
scroll-view {
  background-color: var(--bg);
}

page {
  height: 100%;
  font-family: var(--font-body);
  background-color: var(--bg);
  background-image: linear-gradient(180deg, #fdfcfa 0%, var(--bg) 35%, var(--bg-soft) 100%);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.55;
  letter-spacing: 0.2rpx;
}

.font-display {
  font-family: var(--font-display);
}

/* 通用容器 */
.container {
  padding: 32rpx;
  padding-bottom: 40rpx;
}

/* ---- 卡片（浅色表面 + 柔和投影）---- */
.card {
  background: var(--surface);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border);
  box-shadow: var(--shadow);
}

/* ---- 按钮：主色为指南橙 accent ---- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(145deg, #e08568 0%, #d97757 48%, #c96a4d 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(217, 119, 87, 0.35);
}

.btn-primary:active {
  opacity: 0.88;
  transform: translateY(2rpx);
}

.btn-secondary {
  background: var(--surface-solid);
  color: var(--text);
  border: 1rpx solid var(--border);
  box-shadow: var(--shadow-sm);
}

.btn-secondary:active {
  background: var(--bg-muted);
}

/* ---- 输入框（浅底可读）---- */
.input {
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--surface-solid);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--text);
  border: 1rpx solid var(--border);
}

.input-placeholder {
  color: var(--text-secondary);
}

/* ---- 列表行 ---- */
.list-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.72);
  border-bottom: 1rpx solid var(--border);
}

/* ---- 标签 ---- */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.tag-primary {
  background: rgba(217, 119, 87, 0.12);
  color: #c45a3d;
}

.tag-warning {
  background: rgba(255, 171, 0, 0.12);
  color: #c97800;
}

/* ---- 文本语义色 ---- */
.text-primary {
  color: var(--accent-orange);
}

.text-secondary {
  color: var(--text-secondary);
}

/* ---- Section 标题 ---- */
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 32rpx;
  letter-spacing: 0.5rpx;
}

/* ---- 头像占位 ---- */
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 14rpx;
  background: linear-gradient(145deg, var(--bg-muted) 0%, #dcd8cc 100%);
  border: 1rpx solid var(--border);
}

/* ---- 底部安全区域 ---- */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
