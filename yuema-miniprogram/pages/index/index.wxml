<page-meta root-background-color="{{themeMeta.rootBg}}" background-color="{{themeMeta.bg}}" background-color-bottom="{{themeMeta.bgBottom}}" background-text-style="{{themeMeta.textStyle}}" />
<!-- page 级滚动条难隐藏：用全高 scroll-view 承担纵向滚动 + 自定义下拉刷新（替代页面 enablePullDownRefresh） -->
<view class="page-native-scroll-host">
  <scroll-view class="index-tab-page-scroll" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}" refresher-enabled="{{true}}" refresher-background="{{themeMeta.bg}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onIndexRefresherRefresh">
<view class="{{themeScopeClass}}">
<view class="container home-page">
  <!-- 顶部问候 -->
  <view class="greeting">
    <view class="greeting-text">
      <view class="location-box" bindtap="reSelectLocation">
        <text class="location-icon">📍</text>
        <view class="location-name-wrap">
          <text class="location-name">{{address || '获取位置中...'}}</text>
        </view>
        <text class="location-arrow">></text>
      </view>
      <view class="greeting-headline">
        <text class="greeting-hello">约麻</text>
        <text class="greeting-sub">找到你的牌搭子</text>
      </view>
    </view>
    <!-- 无头像时用占位底+人物图标，避免缺省 PNG 时出现整块空灰 -->
    <view class="greeting-avatar" bindtap="goToUser">
      <block wx:if="{{userInfo.avatarUrl}}">
        <image src="{{userInfo.avatarUrl}}" mode="aspectFill" class="avatar greeting-avatar-img"/>
      </block>
      <view wx:else class="greeting-avatar-fallback">
        <image class="greeting-avatar-icon" src="{{themeIsDark ? '/images/icons/ic-user-dark.svg' : '/images/icons/ic-user.svg'}}" mode="aspectFit"/>
      </view>
    </view>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input">
      <text class="search-icon">⌕</text>
      <input placeholder="搜索牌局、场地" disabled placeholder-style="{{themeInputPlaceholderStyle}}"/>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="quick-actions">
    <view class="action-item" bindtap="createRoom">
      <view class="action-icon action-create">
        <text class="action-emoji">+</text>
      </view>
      <text class="action-label">创建牌局</text>
    </view>
    <view class="action-item" bindtap="joinRoom">
      <view class="action-icon action-join">
        <text class="action-emoji">⎔</text>
      </view>
      <text class="action-label">加入牌局</text>
    </view>
    <view class="action-item" bindtap="goToVenue">
      <view class="action-icon action-venue">
        <text class="action-emoji">◎</text>
      </view>
      <text class="action-label">附近场地</text>
    </view>
    <view class="action-item" bindtap="goToHistory">
      <view class="action-icon action-history">
        <text class="action-emoji">☰</text>
      </view>
      <text class="action-label">历史战绩</text>
    </view>
  </view>

  <!-- 推荐牌局 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">推荐牌局</text>
      <text class="section-more" bindtap="goToRoomList">查看全部</text>
    </view>
    
    <view class="room-list">
      <!-- 骨架屏：仅在第一次加载且无数据时展示 -->
      <block wx:if="{{loading && roomList.length === 0}}">
        <view class="skeleton-card skeleton-room" wx:for="{{2}}" wx:key="index">
          <view class="skeleton-shimmer"></view>
          <view class="skeleton-item" style="width: 40%; height: 40rpx;"></view>
          <view class="skeleton-item" style="width: 100%; height: 30rpx;"></view>
          <view class="skeleton-item" style="width: 80%; height: 30rpx;"></view>
        </view>
      </block>
      
      <block wx:else>
        <view class="room-card" wx:for="{{roomList}}" wx:key="id" bindtap="goToRoomDetail" data-id="{{item.id}}">
          <view class="room-card-header">
            <view class="room-card-left">
              <text class="room-no-text">#{{item.roomNo}}</text>
              <text class="room-game-type">{{gameTypeMap[item.gameType]}}</text>
            </view>
            <view class="status-pill {{item.status === 0 ? 'status-waiting' : 'status-playing'}}">
              <view class="status-dot"></view>
              <text>{{item.status === 0 ? '等待中' : '进行中'}}</text>
            </view>
          </view>
          <view class="room-card-body">
            <view class="room-meta-row">
              <text class="meta-label">人数</text>
              <text class="meta-value">{{item.currentPlayers}}/{{item.maxPlayers}}</text>
            </view>
            <view class="room-meta-row" wx:if="{{item.scheduleDisplayStart}}">
              <text class="meta-label">开始范围</text>
              <text class="meta-value">{{item.scheduleDisplayStart}}</text>
            </view>
            <view class="room-meta-row" wx:if="{{item.scheduleDisplayDuration}}">
              <text class="meta-label">预计时长</text>
              <text class="meta-value">{{item.scheduleDisplayDuration}}</text>
            </view>
            <view class="room-meta-row" wx:if="{{item.venueName}}">
              <text class="meta-label">场地</text>
              <text class="meta-value venue-name-text">{{item.venueName}}</text>
            </view>
            <view class="room-meta-row" wx:if="{{item.remark}}">
              <text class="meta-label">备注</text>
              <text class="meta-value room-card-remark">{{item.remark}}</text>
            </view>
            <!-- 与详情页「本场约定」一致：含四川加底/加番单选结果 -->
            <view class="room-rule-tags" wx:if="{{item.ruleCardTags && item.ruleCardTags.length}}">
              <text class="room-rule-tag" wx:for="{{item.ruleCardTags}}" wx:for-item="tag" wx:key="key">{{tag.label}}</text>
            </view>
          </view>
          <view class="room-card-footer">
            <block wx:if="{{currentUserId && item.creatorId === currentUserId && item.status === 0}}">
              <button class="room-secondary-btn" size="mini" catchtap="goEditRoom" data-id="{{item.id}}">编辑</button>
              <button class="room-danger-btn" size="mini" catchtap="confirmDeleteRoom" data-id="{{item.id}}">删除</button>
            </block>
            <button wx:else class="room-join-btn" size="mini" catchtap="quickJoin" data-id="{{item.id}}">加入</button>
          </view>
        </view>
      </block>
    </view>

    <view class="empty-state" wx:if="{{roomList.length === 0 && !loading}}">
      <text class="empty-icon">🀄</text>
      <text class="empty-text">暂无推荐牌局</text>
      <button class="btn btn-primary mt-32" style="width: 320rpx;" bindtap="createRoom">创建牌局</button>
    </view>
  </view>

  <!-- 附近场地 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">附近场地</text>
      <text class="section-more" bindtap="goToVenue">查看全部</text>
    </view>
    
    <view class="venue-list">
      <!-- 骨架屏 -->
      <block wx:if="{{loading && venueList.length === 0}}">
        <view class="skeleton-card skeleton-venue" wx:for="{{2}}" wx:key="index">
          <view class="skeleton-shimmer"></view>
          <view class="skeleton-item" style="width: 180rpx; height: 180rpx;"></view>
          <view style="flex: 1; padding: 28rpx; display: flex; flex-direction: column; gap: 16rpx;">
            <view class="skeleton-item" style="width: 60%; height: 32rpx;"></view>
            <view class="skeleton-item" style="width: 40%; height: 24rpx;"></view>
            <view class="skeleton-item" style="width: 100%; height: 24rpx;"></view>
          </view>
        </view>
      </block>

      <block wx:else>
        <view class="venue-card" wx:for="{{venueList}}" wx:key="id" bindtap="goToVenueDetail" data-id="{{item.id}}">
          <view class="venue-card-image">
            <image src="{{item.imageUrls || '/images/default-venue.png'}}" mode="aspectFill"/>
          </view>
          <view class="venue-card-info">
            <text class="venue-card-name">{{item.name}}</text>
            <view class="venue-card-meta">
              <text class="venue-rating">{{item.rating}} ⭐</text>
              <text class="venue-price">¥{{item.minPrice/100}}/h</text>
            </view>
            <text class="venue-card-address">{{item.address}}</text>
          </view>
        </view>
      </block>
    </view>
  </view>
</view>
</view>
  </scroll-view>
</view>
