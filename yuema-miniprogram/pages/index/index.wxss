/* 顶部问候 */
.greeting {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0;
}

.greeting-hello {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: -1rpx;
}

.greeting-sub {
  font-size: 26rpx;
  color: #8A9096;
  margin-top: 8rpx;
}

.greeting-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  overflow: hidden;
  border: 1rpx solid #1F1F1F;
}

/* 搜索栏 */
.search-bar {
  margin-bottom: 48rpx;
}

.search-input {
  display: flex;
  align-items: center;
  background: #101214;
  border-radius: 8rpx;
  padding: 24rpx;
  border: 1rpx solid #1F1F1F;
}

.search-icon {
  font-size: 32rpx;
  color: #4B4B4B;
  margin-right: 20rpx;
}

.search-input input {
  flex: 1;
  font-size: 28rpx;
  color: #ffffff;
}

/* 快捷入口 (Trae 风格网格) */
.quick-actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  margin-bottom: 64rpx;
}

.action-item {
  background: #101214;
  border: 1rpx solid #1F1F1F;
  border-radius: 12rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  transition: all 0.2s ease;
}

.action-item:active {
  border-color: #28E088;
  background: #1A1D21;
}

.action-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

/* 渐变色保持 Trae 调性 */
.action-create { background: rgba(40, 224, 136, 0.1); color: #28E088; }
.action-join { background: rgba(0, 184, 148, 0.1); color: #00b894; }
.action-venue { background: rgba(255, 171, 0, 0.1); color: #FFAB00; }
.action-history { background: rgba(138, 144, 150, 0.1); color: #8A9096; }

.action-label {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 600;
}

/* Section */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.section-title {
  margin-bottom: 0;
}

.section-more {
  font-size: 24rpx;
  color: #28E088;
  font-weight: 500;
}

/* 牌局卡片 */
.room-card {
  background: #101214;
  border-radius: 12rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #1F1F1F;
}

.room-no-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
}

.status-pill {
  display: flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.status-waiting { background: rgba(40, 224, 136, 0.1); color: #28E088; }
.status-playing { background: rgba(138, 144, 150, 0.1); color: #8A9096; }

.room-meta-row {
  display: flex;
  margin-top: 16rpx;
  font-size: 26rpx;
}

.meta-label {
  color: #4B4B4B;
  width: 80rpx;
}

.meta-value {
  color: #8A9096;
}

.room-card-footer {
  margin-top: 24rpx;
  border-top: 1rpx solid #1F1F1F;
  padding-top: 24rpx;
  display: flex;
  justify-content: flex-end;
}

.room-join-btn {
  background: #28E088;
  color: #000000;
  border-radius: 8rpx;
  padding: 12rpx 32rpx;
  font-size: 24rpx;
  font-weight: 600;
}

/* 场地卡片 */
.venue-card {
  display: flex;
  background: #101214;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  border: 1rpx solid #1F1F1F;
}

.venue-card-image {
  width: 180rpx;
  height: 180rpx;
}

.venue-card-info {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.venue-card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.venue-price {
  color: #28E088;
  font-size: 24rpx;
  font-weight: 600;
}

.venue-card-address {
  color: #4B4B4B;
  font-size: 22rpx;
}
