/* 首页 — 高级感暗色：层次、留白、柔和描边与阴影 */

.home-page {
  min-height: 100%;
  padding-top: 8rpx;
  padding-bottom: 56rpx;
}

/* 顶部问候 */
.greeting {
  display: flex;
  align-items: flex-start;
  gap: 28rpx;
  padding: 28rpx 0 36rpx;
}

.greeting-text {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 18rpx;
  flex: 1;
  min-width: 0;
}

.greeting-headline {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  width: 100%;
}

.greeting-hello {
  font-size: 48rpx;
  font-weight: 600;
  color: #fafbfc;
  letter-spacing: 1rpx;
  flex-shrink: 0;
}

.location-box {
  display: flex;
  align-items: center;
  align-self: flex-start;
  max-width: 100%;
  box-sizing: border-box;
  background: rgba(50, 216, 168, 0.07);
  padding: 12rpx 20rpx;
  border-radius: 100rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.2);
}

.location-icon {
  font-size: 24rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.location-name-wrap {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.location-name {
  font-size: 24rpx;
  color: #5ee5b8;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 500;
}

.location-arrow {
  font-size: 20rpx;
  color: #5ee5b8;
  margin-left: 10rpx;
  opacity: 0.55;
  flex-shrink: 0;
}

.greeting-sub {
  font-size: 24rpx;
  color: #7d848e;
  flex-shrink: 0;
  text-align: right;
  max-width: 280rpx;
  font-weight: 400;
  letter-spacing: 0.5rpx;
}

.greeting-avatar {
  flex-shrink: 0;
  width: 92rpx;
  height: 92rpx;
  border-radius: 18rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow:
    0 8rpx 28rpx rgba(0, 0, 0, 0.35),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
}

.greeting-avatar .avatar {
  width: 100%;
  height: 100%;
  border-radius: 0;
}

/* 搜索栏 */
.search-bar {
  margin-bottom: 40rpx;
}

.search-input {
  display: flex;
  align-items: center;
  background: rgba(19, 22, 28, 0.65);
  border-radius: 18rpx;
  padding: 26rpx 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  box-shadow:
    0 10rpx 40rpx rgba(0, 0, 0, 0.28),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.04);
}

.search-icon {
  font-size: 30rpx;
  color: #5c626a;
  margin-right: 20rpx;
  opacity: 0.9;
}

.search-input input {
  flex: 1;
  font-size: 28rpx;
  color: #f4f5f7;
}

/* 快捷入口 */
.quick-actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 56rpx;
}

.action-item {
  background: rgba(19, 22, 28, 0.88);
  border: 1rpx solid rgba(255, 255, 255, 0.055);
  border-radius: 22rpx;
  padding: 36rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.32);
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.action-item:active {
  border-color: rgba(74, 232, 184, 0.35);
  box-shadow:
    0 14rpx 44rpx rgba(0, 0, 0, 0.38),
    0 0 0 1rpx rgba(74, 232, 184, 0.12);
}

.action-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
}

.action-emoji {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1;
}

.action-create {
  background: rgba(74, 232, 184, 0.11);
  color: #4ae8b8;
}

.action-join {
  background: rgba(46, 196, 182, 0.1);
  color: #4fd4c4;
}

.action-venue {
  background: rgba(232, 178, 72, 0.1);
  color: #e8c066;
}

.action-history {
  background: rgba(138, 144, 150, 0.08);
  color: #9aa1a8;
}

.action-label {
  font-size: 28rpx;
  color: #eef0f3;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

/* Section */
.section {
  margin-bottom: 52rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
  padding-top: 4rpx;
}

.section-title {
  margin-bottom: 0;
  font-size: 34rpx;
  font-weight: 600;
  color: #fafbfc;
  letter-spacing: 1rpx;
}

.section-more {
  font-size: 24rpx;
  color: #4ae8b8;
  font-weight: 500;
  letter-spacing: 0.5rpx;
  opacity: 0.95;
}

/* 牌局卡片 */
.room-card {
  background: rgba(19, 22, 28, 0.92);
  border-radius: 22rpx;
  padding: 34rpx 32rpx 32rpx;
  margin-bottom: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.055);
  box-shadow: 0 14rpx 48rpx rgba(0, 0, 0, 0.36);
}

.room-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 22rpx;
}

.room-card-left {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10rpx;
  min-width: 0;
  flex: 1;
}

.room-no-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #fafbfc;
  letter-spacing: 0.5rpx;
}

.room-game-type {
  font-size: 24rpx;
  font-weight: 500;
  color: #6e757e;
  letter-spacing: 0.3rpx;
}

.status-pill {
  display: flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border-radius: 100rpx;
  font-size: 22rpx;
  font-weight: 500;
  flex-shrink: 0;
  border: 1rpx solid transparent;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.status-waiting {
  background: rgba(74, 232, 184, 0.1);
  color: #5ee5b8;
  border-color: rgba(74, 232, 184, 0.18);
}

.status-waiting .status-dot {
  background: #4ae8b8;
  box-shadow: 0 0 12rpx rgba(74, 232, 184, 0.45);
}

.status-playing {
  background: rgba(138, 144, 150, 0.08);
  color: #9aa1a8;
  border-color: rgba(255, 255, 255, 0.06);
}

.status-playing .status-dot {
  background: #8a9096;
}

.room-meta-row {
  display: flex;
  margin-top: 14rpx;
  font-size: 26rpx;
}

.room-meta-row:first-child {
  margin-top: 0;
}

.meta-label {
  color: #505860;
  width: 80rpx;
  font-weight: 400;
}

.meta-value {
  color: #9aa1a8;
  flex: 1;
}

.room-card-footer {
  margin-top: 28rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  padding-top: 26rpx;
  display: flex;
  justify-content: flex-end;
}

.room-join-btn {
  background: linear-gradient(145deg, #3ae8b0 0%, #28c993 52%, #22b882 100%) !important;
  color: #061210 !important;
  border-radius: 14rpx !important;
  padding: 14rpx 40rpx !important;
  font-size: 26rpx !important;
  font-weight: 600 !important;
  letter-spacing: 1rpx;
  border: none !important;
  box-shadow: 0 8rpx 22rpx rgba(40, 201, 147, 0.28);
}

.room-join-btn::after {
  border: none;
}

/* 场地卡片 */
.venue-card {
  display: flex;
  background: rgba(19, 22, 28, 0.92);
  border-radius: 22rpx;
  overflow: hidden;
  margin-bottom: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.055);
  box-shadow: 0 14rpx 48rpx rgba(0, 0, 0, 0.36);
}

.venue-card-image {
  width: 180rpx;
  height: 180rpx;
}

.venue-card-info {
  flex: 1;
  padding: 28rpx 26rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.venue-card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #fafbfc;
  letter-spacing: 0.3rpx;
}

.venue-price {
  color: #4ae8b8;
  font-size: 24rpx;
  font-weight: 600;
}

.venue-card-address {
  color: #5c626a;
  font-size: 22rpx;
  line-height: 1.45;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 72rpx 32rpx 48rpx;
  color: #5c626a;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
  opacity: 0.85;
}

.empty-text {
  font-size: 28rpx;
  color: #6e757e;
  letter-spacing: 0.5rpx;
}

.mt-32 {
  margin-top: 32rpx;
}
