/* 首页 — Anthropic 浅色：卡片层次、柔和分隔与橙色强调 */

/* 禁止 page 自身滚动，避免出现整页原生滚动条；纵向滚动由 index.wxml 内 scroll-view 承担 */
page {
  height: 100%;
  overflow: hidden;
}

.page-native-scroll-host {
  height: 100%;
}

.index-tab-page-scroll {
  height: 100%;
  box-sizing: border-box;
}

.home-page {
  min-height: 100%;
  padding-top: 8rpx;
  padding-bottom: 56rpx;
}

/* 顶部问候 */
.greeting {
  display: flex;
  align-items: flex-start;
  gap: 28rpx;
  padding: 28rpx 0 36rpx;
}

.greeting-text {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 18rpx;
  flex: 1;
  min-width: 0;
}

.greeting-headline {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  width: 100%;
}

.greeting-hello {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--text);
  letter-spacing: 1rpx;
  flex-shrink: 0;
}

.location-box {
  display: flex;
  align-items: center;
  align-self: flex-start;
  max-width: 100%;
  box-sizing: border-box;
  background: rgba(217, 119, 87, 0.1);
  padding: 12rpx 20rpx;
  border-radius: 100rpx;
  border: 1rpx solid var(--border);
  box-shadow: var(--shadow-sm);
}

.location-icon {
  font-size: 24rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.location-name-wrap {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.location-name {
  font-size: 24rpx;
  color: var(--tag-primary-fg);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 500;
}

.location-arrow {
  font-size: 20rpx;
  color: var(--accent-orange);
  margin-left: 10rpx;
  opacity: 0.65;
  flex-shrink: 0;
}

.greeting-sub {
  font-size: 24rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
  text-align: right;
  max-width: 280rpx;
  font-weight: 400;
  letter-spacing: 0.5rpx;
}

.greeting-avatar {
  flex-shrink: 0;
  width: 92rpx;
  height: 92rpx;
  border-radius: 18rpx;
  overflow: hidden;
  border: 1rpx solid var(--border);
  box-shadow: var(--shadow-sm);
}

.greeting-avatar .greeting-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 0;
}

.greeting-avatar-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, var(--bg-muted) 0%, var(--avatar-gradient-end) 100%);
}

.greeting-avatar-icon {
  width: 52rpx;
  height: 52rpx;
  opacity: 0.92;
}

/* 搜索栏 */
.search-bar {
  margin-bottom: 40rpx;
}

.search-input {
  display: flex;
  align-items: center;
  background: var(--surface-solid);
  border-radius: 18rpx;
  padding: 26rpx 28rpx;
  border: 1rpx solid var(--border);
  box-shadow: var(--shadow-sm);
}

.search-icon {
  font-size: 30rpx;
  color: var(--text-secondary);
  margin-right: 20rpx;
  opacity: 0.95;
}

.search-input input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
}

/* 快捷入口 */
.quick-actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 56rpx;
}

.action-item {
  background: var(--surface-solid);
  border: 1rpx solid var(--border);
  border-radius: 22rpx;
  padding: 36rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  box-shadow: var(--shadow-sm);
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.action-item:active {
  border-color: var(--accent-orange-border);
  box-shadow: var(--shadow);
}

.action-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.14);
}

.action-emoji {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1;
}

.action-create {
  background: rgba(217, 119, 87, 0.12);
  color: var(--tag-primary-fg);
}

.action-join {
  background: rgba(106, 155, 204, 0.14);
  color: var(--accent-blue);
}

.action-venue {
  background: rgba(120, 140, 93, 0.14);
  color: var(--accent-green);
}

.action-history {
  background: rgba(176, 174, 165, 0.18);
  color: var(--text-secondary);
}

.action-label {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

/* Section */
.section {
  margin-bottom: 52rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
  padding-top: 4rpx;
}

.section-title {
  margin-bottom: 0;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
  letter-spacing: 1rpx;
}

.section-more {
  font-size: 24rpx;
  color: var(--accent-orange);
  font-weight: 500;
  letter-spacing: 0.5rpx;
  opacity: 0.98;
}

/* 牌局卡片 */
.room-card {
  background: var(--surface-solid);
  border-radius: 22rpx;
  padding: 34rpx 32rpx 32rpx;
  margin-bottom: 22rpx;
  border: 1rpx solid var(--border);
  box-shadow: var(--shadow);
}

.room-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 22rpx;
}

.room-card-left {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10rpx;
  min-width: 0;
  flex: 1;
}

.room-no-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  letter-spacing: 0.5rpx;
}

.room-game-type {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-secondary);
  letter-spacing: 0.3rpx;
}

.status-pill {
  display: flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border-radius: 100rpx;
  font-size: 22rpx;
  font-weight: 500;
  flex-shrink: 0;
  border: 1rpx solid transparent;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.status-waiting {
  background: rgba(217, 119, 87, 0.12);
  color: var(--tag-primary-fg);
  border-color: rgba(217, 119, 87, 0.22);
}

.status-waiting .status-dot {
  background: var(--accent-orange);
  box-shadow: 0 0 12rpx rgba(217, 119, 87, 0.35);
}

.status-playing {
  background: var(--bg-muted);
  color: var(--text-secondary);
  border-color: var(--border);
}

.status-playing .status-dot {
  background: var(--text-secondary);
}

.room-meta-row {
  display: flex;
  margin-top: 14rpx;
  font-size: 26rpx;
}

.room-meta-row:first-child {
  margin-top: 0;
}

.meta-label {
  color: var(--text-secondary);
  width: 80rpx;
  font-weight: 400;
}

.meta-value {
  color: var(--text-secondary);
  flex: 1;
}

/* 卡片备注：允许换行，避免长文案撑破横向布局 */
.room-card-remark {
  min-width: 0;
  white-space: normal;
  word-break: break-word;
  line-height: 1.45;
}

/* 推荐牌局卡片：玩法细则标签（与详情 rule-tag 风格统一略缩小） */
.room-rule-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.room-rule-tag {
  font-size: 22rpx;
  color: var(--tag-primary-fg);
  background: rgba(217, 119, 87, 0.12);
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
}

.room-card-footer {
  margin-top: 28rpx;
  border-top: 1rpx solid var(--border);
  padding-top: 26rpx;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

/* 本人牌局：次要操作按钮（编辑） */
.room-secondary-btn {
  margin: 0 !important;
  background: var(--surface-solid) !important;
  color: var(--text-secondary) !important;
  border: 1rpx solid var(--border) !important;
  border-radius: 14rpx !important;
  padding: 14rpx 28rpx !important;
  font-size: 26rpx !important;
  font-weight: 600 !important;
}

.room-secondary-btn::after {
  border: none;
}

/* 本人牌局：删除 */
.room-danger-btn {
  margin: 0 !important;
  background: rgba(255, 77, 79, 0.12) !important;
  color: var(--danger) !important;
  border: 1rpx solid rgba(207, 19, 34, 0.35) !important;
  border-radius: 14rpx !important;
  padding: 14rpx 28rpx !important;
  font-size: 26rpx !important;
  font-weight: 600 !important;
}

.room-danger-btn::after {
  border: none;
}

.room-join-btn {
  background: linear-gradient(145deg, #e08568 0%, var(--accent-orange) 52%, #c96a4d 100%) !important;
  color: var(--btn-primary-text) !important;
  border-radius: 14rpx !important;
  padding: 14rpx 40rpx !important;
  font-size: 26rpx !important;
  font-weight: 600 !important;
  letter-spacing: 1rpx;
  border: none !important;
  box-shadow: 0 8rpx 22rpx rgba(217, 119, 87, 0.32);
}

.room-join-btn::after {
  border: none;
}

/* 场地卡片 */
.venue-card {
  display: flex;
  background: var(--surface-solid);
  border-radius: 22rpx;
  overflow: hidden;
  margin-bottom: 22rpx;
  border: 1rpx solid var(--border);
  box-shadow: var(--shadow);
}

.venue-card-image {
  width: 180rpx;
  height: 180rpx;
}

.venue-card-info {
  flex: 1;
  padding: 28rpx 26rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.venue-card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  letter-spacing: 0.3rpx;
}

.venue-price {
  color: var(--accent-orange);
  font-size: 24rpx;
  font-weight: 600;
}

.venue-card-address {
  color: var(--text-secondary);
  font-size: 22rpx;
  line-height: 1.45;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 72rpx 32rpx 48rpx;
  color: var(--text-secondary);
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
  opacity: 0.85;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  letter-spacing: 0.5rpx;
}

.mt-32 {
  margin-top: 32rpx;
}
