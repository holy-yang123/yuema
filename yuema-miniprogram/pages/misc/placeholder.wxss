.placeholder-wrap {
  min-height: 100%;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.placeholder-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 24rpx;
  text-align: center;
}

.placeholder-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  text-align: center;
  margin-bottom: 56rpx;
}

.placeholder-btn {
  width: 100%;
  max-width: 520rpx;
  background: linear-gradient(145deg, #e08568 0%, #d97757 100%) !important;
  color: var(--btn-primary-text) !important;
  height: 96rpx !important;
  line-height: 96rpx !important;
  border-radius: 12rpx !important;
  font-weight: 700 !important;
  font-size: 30rpx !important;
}

.theme-scope--dark .placeholder-btn {
  background: linear-gradient(145deg, #f0a080 0%, #e89572 100%) !important;
}
