/* 与 app.wxss 令牌衔接：暖纸色底 + 橙绿点缀 */
.login-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(168deg, #fdfcfa 0%, #faf8f2 42%, #f2ebe2 100%);
}

.login-canvas {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 0;
  pointer-events: none;
}

/* 静态装饰圆：替代 blur，兼容小程序渲染 */
.login-deco {
  position: fixed;
  pointer-events: none;
  z-index: 0;
  border-radius: 50%;
}

.login-deco--a {
  width: 520rpx;
  height: 520rpx;
  top: -180rpx;
  right: -140rpx;
  background: radial-gradient(circle, rgba(217, 119, 87, 0.2) 0%, rgba(217, 119, 87, 0.06) 45%, transparent 68%);
}

.login-deco--b {
  width: 380rpx;
  height: 380rpx;
  bottom: 22%;
  left: -120rpx;
  background: radial-gradient(circle, rgba(106, 155, 204, 0.14) 0%, transparent 65%);
}

.login-deco--c {
  width: 280rpx;
  height: 280rpx;
  bottom: -80rpx;
  right: 10%;
  background: radial-gradient(circle, rgba(120, 140, 93, 0.12) 0%, transparent 70%);
}

.login-layer {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 72rpx 48rpx 48rpx;
  display: flex;
  flex-direction: column;
}

.login-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 48rpx;
}

/* 品牌卡片：浅色玻璃感 + 细边框 */
.login-card {
  width: 100%;
  max-width: 620rpx;
  padding: 56rpx 44rpx 52rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.58);
  border: 1rpx solid rgba(20, 20, 19, 0.06);
  box-shadow: 0 24rpx 80rpx rgba(20, 20, 19, 0.06), 0 4rpx 16rpx rgba(217, 119, 87, 0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: login-rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.login-badge {
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
  text-transform: uppercase;
  color: #c45a3d;
  margin-bottom: 36rpx;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(217, 119, 87, 0.1);
  border: 1rpx solid rgba(217, 119, 87, 0.15);
  animation: login-rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.06s both;
}

.login-title {
  font-size: 72rpx;
  font-weight: 700;
  color: #141413;
  letter-spacing: 12rpx;
  line-height: 1.15;
  text-shadow: 0 2rpx 0 rgba(255, 255, 255, 0.9);
  animation: login-rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.1s both;
}

.login-title-line {
  width: 72rpx;
  height: 8rpx;
  margin-top: 28rpx;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #d97757 0%, #e8a090 50%, rgba(217, 119, 87, 0.35) 100%);
  animation: login-rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.14s both;
}

.login-desc {
  margin-top: 32rpx;
  font-size: 28rpx;
  color: #8a877c;
  text-align: center;
  line-height: 1.65;
  max-width: 520rpx;
  animation: login-rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.18s both;
}

.login-features {
  margin-top: 40rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8rpx 12rpx;
  animation: login-rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.22s both;
}

.login-chip {
  font-size: 24rpx;
  font-weight: 500;
  color: #5c5a54;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(241, 237, 228, 0.95);
  border: 1rpx solid rgba(20, 20, 19, 0.06);
}

.login-dot {
  font-size: 22rpx;
  color: #c9c5bb;
  padding: 0 4rpx;
}

.login-actions {
  flex-shrink: 0;
  width: 100%;
  max-width: 620rpx;
  margin: 0 auto;
  padding-top: 16rpx;
}

.login-btn {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(155deg, #e59172 0%, #d97757 38%, #c96a4d 100%);
  border: none;
  box-shadow: 0 16rpx 44rpx rgba(217, 119, 87, 0.38), inset 0 2rpx 0 rgba(255, 255, 255, 0.22);
  animation: login-rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.28s both;
  transition: transform 0.15s ease, opacity 0.15s ease, box-shadow 0.15s ease;
}

.login-btn::after {
  border: none;
}

.login-btn:active,
.login-btn--pressed {
  transform: scale(0.98);
  opacity: 0.94;
  box-shadow: 0 10rpx 28rpx rgba(217, 119, 87, 0.28), inset 0 2rpx 0 rgba(255, 255, 255, 0.15);
}

.login-hint {
  display: block;
  margin-top: 28rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  color: #b0aea5;
  text-align: center;
  line-height: 1.55;
  animation: login-rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.34s both;
}

@keyframes login-rise {
  from {
    opacity: 0;
    transform: translateY(32rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}
