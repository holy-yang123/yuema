<page-meta root-background-color="{{themeMeta.rootBg}}" background-color="{{themeMeta.bg}}" background-color-bottom="{{themeMeta.bgBottom}}" background-text-style="{{themeMeta.textStyle}}" />
<!-- 内层 view 作滚动容器，便于 WebKit 隐藏条；弹窗为 position:fixed 不受影响 -->
<view class="page-native-scroll-host">
  <view class="page-native-scroll-body">
<view class="{{themeScopeClass}}">
<view class="container">
  <!-- 用户信息卡片 -->
  <view class="profile-hero">
    <view class="profile-hero-bg"></view>
    <view class="profile-hero-content">
      <view class="profile-avatar-wrap">
        <image class="profile-avatar" src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"/>
        <view class="profile-level-ring">
          <text class="profile-level-text">Lv.{{userInfo.level || 1}}</text>
        </view>
      </view>
      <text class="profile-name">{{userInfo.id ? userInfo.nickname : '访客您好'}}</text>
      <text class="profile-title" wx:if="{{userInfo.id}}">{{levelName}}</text>
      <!-- 信誉与弱实名状态：与房间成员列表字段对齐，便于用户自查 -->
      <view class="profile-trust-row" wx:if="{{userInfo.id}}">
        <text class="profile-trust-text">信誉 {{trustSummary.reputation}}</text>
        <text class="profile-trust-dot">·</text>
        <text class="profile-trust-text {{trustSummary.verified ? 'is-verified' : ''}}">{{trustSummary.realnameText}}</text>
      </view>
      <button class="login-trigger-btn" wx:else bindtap="onLogin">点击登录账户</button>
    </view>
    <view class="profile-stats-row">
      <view class="profile-stat">
        <text class="stat-num">{{userInfo.totalGames || 0}}</text>
        <text class="stat-desc">总对局</text>
      </view>
      <view class="stat-divider"></view>
      <view class="profile-stat">
        <text class="stat-num">{{userInfo.winGames || 0}}</text>
        <text class="stat-desc">胜局</text>
      </view>
      <view class="stat-divider"></view>
      <view class="profile-stat">
        <text class="stat-num">{{winRate}}%</text>
        <text class="stat-desc">胜率</text>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-group">
    <view class="menu-item" bindtap="goToMyRooms">
      <view class="menu-icon-wrap">
        <image class="menu-icon-img" src="{{themeIsDark ? '/images/icons/ic-game-dark.svg' : '/images/icons/ic-game.svg'}}" mode="aspectFit" />
      </view>
      <text class="menu-item-text">我的牌局</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToHistory">
      <view class="menu-icon-wrap">
        <image class="menu-icon-img" src="{{themeIsDark ? '/images/icons/ic-chart-dark.svg' : '/images/icons/ic-chart.svg'}}" mode="aspectFit" />
      </view>
      <text class="menu-item-text">历史战绩</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToFriends">
      <view class="menu-icon-wrap">
        <image class="menu-icon-img" src="{{themeIsDark ? '/images/icons/ic-friends-dark.svg' : '/images/icons/ic-friends.svg'}}" mode="aspectFit" />
      </view>
      <text class="menu-item-text">我的好友</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToOrders">
      <view class="menu-icon-wrap">
        <image class="menu-icon-img" src="{{themeIsDark ? '/images/icons/ic-order-dark.svg' : '/images/icons/ic-order.svg'}}" mode="aspectFit" />
      </view>
      <text class="menu-item-text">我的订单</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 设置菜单 -->
  <view class="menu-group">
    <view class="menu-item menu-item--switch">
      <view class="menu-icon-wrap">
        <image class="menu-icon-img" src="{{themeIsDark ? '/images/icons/ic-sun-dark.svg' : '/images/icons/ic-moon.svg'}}" mode="aspectFit" />
      </view>
      <text class="menu-item-text">深色模式</text>
      <switch class="theme-switch" checked="{{themeIsDark}}" bindchange="onThemeDarkChange" color="{{themeSwitchColor}}" />
    </view>
    <view class="menu-item" bindtap="editProfile">
      <view class="menu-icon-wrap">
        <image class="menu-icon-img" src="{{themeIsDark ? '/images/icons/ic-edit-dark.svg' : '/images/icons/ic-edit.svg'}}" mode="aspectFit" />
      </view>
      <text class="menu-item-text">编辑资料</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="bindPhone">
      <view class="menu-icon-wrap">
        <image class="menu-icon-img" src="{{themeIsDark ? '/images/icons/ic-phone-dark.svg' : '/images/icons/ic-phone.svg'}}" mode="aspectFit" />
      </view>
      <text class="menu-item-text">绑定手机</text>
      <text class="menu-item-status">{{phoneMenuStatus}}</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="openWxRealnameModal">
      <view class="menu-icon-wrap">
        <image class="menu-icon-img" src="{{themeIsDark ? '/images/icons/ic-edit-dark.svg' : '/images/icons/ic-edit.svg'}}" mode="aspectFit" />
      </view>
      <text class="menu-item-text">微信手机号实名</text>
      <text class="menu-item-status">{{trustSummary.verified ? '已完成' : '推荐'}}</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="showAbout">
      <view class="menu-icon-wrap">
        <image class="menu-icon-img" src="{{themeIsDark ? '/images/icons/ic-about-dark.svg' : '/images/icons/ic-about.svg'}}" mode="aspectFit" />
      </view>
      <text class="menu-item-text">关于约麻</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-area safe-bottom" wx:if="{{userInfo.id}}">
    <button class="logout-btn" bindtap="logout">退出登录</button>
  </view>

  <!-- 登录授权弹窗 (Trae Solo 风格) -->
  <view class="login-modal {{showLoginModal ? 'show' : ''}}">
    <view class="login-modal-mask" bindtap="closeLoginModal"></view>
    <view class="login-modal-content">
      <view class="modal-header">
        <text class="modal-title">完善个人资料</text>
        <text class="modal-subtitle">请选择头像并填写昵称以开启约麻之旅</text>
      </view>
      
      <view class="login-form">
        <button class="avatar-wrapper" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" disabled="{{avatarPickDelay}}">
          <image class="modal-avatar" src="{{tempAvatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"></image>
          <view class="avatar-edit-tag">更换</view>
        </button>
        
        <!-- value+bindinput：未失焦就点「进入约麻」时仍能读到昵称（与编辑资料弹窗一致） -->
        <view class="nickname-input-wrap">
          <text class="input-label">昵称</text>
          <input type="nickname" class="nickname-input" placeholder="请输入昵称" value="{{tempNickname}}" bindinput="onLoginNicknameInput" bindblur="onNicknameBlur" />
        </view>
      </view>

      <button class="confirm-login-btn" bindtap="confirmLogin">进入约麻</button>
    </view>
  </view>

  <!-- 编辑资料：与登录完善资料一致，支持昵称 + 微信头像选择 + 上传 -->
  <view class="login-modal {{showEditProfileModal ? 'show' : ''}}">
    <view class="login-modal-mask" bindtap="closeEditProfileModal"></view>
    <view class="login-modal-content">
      <view class="modal-header">
        <text class="modal-title">编辑资料</text>
        <text class="modal-subtitle">可修改昵称与头像</text>
      </view>
      <view class="login-form">
        <button class="avatar-wrapper" open-type="chooseAvatar" bindchooseavatar="onEditChooseAvatar" disabled="{{editAvatarPickDelay}}">
          <image class="modal-avatar" src="{{tempEditAvatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"></image>
          <view class="avatar-edit-tag">更换</view>
        </button>
        <view class="nickname-input-wrap">
          <text class="input-label">昵称</text>
          <input type="nickname" class="nickname-input" placeholder="请输入昵称" value="{{tempEditNickname}}" bindinput="onEditNicknameInput" />
        </view>
      </view>
      <button class="confirm-login-btn" bindtap="confirmEditProfile">保存</button>
    </view>
  </view>

  <!-- 微信手机号快速验证：对接后端 /user/bind-wx-phone，标记 realname_verified -->
  <view class="login-modal {{showWxRealnameModal ? 'show' : ''}}" wx:if="{{showWxRealnameModal}}">
    <view class="login-modal-mask" bindtap="closeWxRealnameModal"></view>
    <view class="login-modal-content">
      <view class="modal-header">
        <text class="modal-title">微信手机号实名</text>
        <text class="modal-subtitle">使用微信官方手机号能力，提升账号可信度与组局安全</text>
      </view>
      <button class="confirm-login-btn" open-type="getPhoneNumber" bindgetphonenumber="onWxPhoneForRealname">授权微信手机号</button>
      <button class="logout-btn wx-realname-cancel" bindtap="closeWxRealnameModal">取消</button>
    </view>
  </view>
</view>
</view>
  </view>
</view>
