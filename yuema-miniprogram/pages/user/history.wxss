.history-page {
  padding-bottom: 48rpx;
}

.stats-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.stats-cell {
  flex: 1;
  text-align: center;
}

.stats-num {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
}

.stats-num.win {
  color: var(--accent-green);
}

.stats-num.lose {
  color: var(--danger);
}

.stats-label {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin: 8rpx 0 24rpx;
  color: var(--text);
}

.empty-tip {
  font-size: 26rpx;
  color: var(--text-secondary);
  text-align: center;
  padding: 48rpx 0;
}

.record-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.record-game {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.record-time {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.record-meta {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}

.record-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.record-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.share-record-btn {
  margin: 0 !important;
  padding: 0 20rpx !important;
  height: 56rpx !important;
  line-height: 54rpx !important;
  font-size: 22rpx !important;
  background: rgba(217, 119, 87, 0.12) !important;
  color: var(--tag-primary-fg) !important;
  border: 1rpx solid rgba(217, 119, 87, 0.35) !important;
  border-radius: 8rpx !important;
}

.share-record-btn::after {
  border: none;
}

.record-score {
  font-size: 32rpx;
  font-weight: 700;
}

.record-score.win {
  color: var(--accent-green);
}

.record-score.lose {
  color: var(--danger);
}

.record-badge {
  font-size: 22rpx;
  color: var(--btn-primary-text);
  background: var(--accent-orange);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.load-more {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-secondary);
  padding: 24rpx;
}
