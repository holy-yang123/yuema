/* 禁止 page 自身滚动条；滚动落在 .page-native-scroll-body（定义见 app.wxss） */
page {
  height: 100%;
  overflow: hidden;
}

.page-native-scroll-host {
  height: 100%;
}

.container {
  min-height: 100%;
  padding: 32rpx;
  box-sizing: border-box;
}

/* 顶部英雄区 */
.profile-hero {
  background: var(--surface-solid);
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
  border: 1rpx solid var(--border);
  box-shadow: var(--shadow-sm);
}

.profile-hero-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 32rpx 48rpx;
}

.profile-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--bg-muted);
  margin-bottom: 24rpx;
  background: var(--bg-muted);
}

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: -1rpx;
  margin-bottom: 8rpx;
}

.profile-title {
  font-size: 24rpx;
  color: var(--accent-orange);
  font-weight: 500;
}

.profile-trust-row {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.profile-trust-text {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.profile-trust-text.is-verified {
  color: var(--accent-orange);
}

.profile-trust-dot {
  font-size: 22rpx;
  color: var(--text-secondary);
  opacity: 0.5;
}

.wx-realname-cancel {
  margin-top: 24rpx;
}

/* 统计行 */
.profile-stats-row {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  background: var(--accent-orange-soft);
  border-top: 1rpx solid var(--bg-muted);
}

.profile-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 4rpx;
}

.stat-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.stat-divider {
  width: 1rpx;
  height: 40rpx;
  background: var(--bg-muted);
}

/* 菜单组 */
.menu-group {
  background: var(--surface-solid);
  border-radius: 16rpx;
  margin-bottom: 32rpx;
  border: 1rpx solid var(--border);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--bg-muted);
  transition: background-color var(--duration) var(--ease-out);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: var(--bg-soft);
}

.menu-item--switch:active {
  background: transparent;
}

.menu-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  margin-right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.menu-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.theme-switch {
  transform: scale(0.92);
}

.menu-item-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
  font-weight: 500;
}

.menu-arrow {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 退出登录 */
.logout-area {
  padding: 32rpx 0;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: transparent;
  color: var(--danger);
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: 1rpx solid rgba(207, 19, 34, 0.28);
}

.theme-scope--dark .logout-btn {
  border-color: rgba(248, 113, 113, 0.35);
}

.logout-btn:active {
  background: var(--accent-orange-soft);
}

.login-trigger-btn {
  margin-top: 24rpx;
  background: linear-gradient(145deg, #e08568 0%, #d97757 100%) !important;
  color: var(--btn-primary-text) !important;
  font-size: 24rpx !important;
  font-weight: 600 !important;
  padding: 0 40rpx !important;
  height: 64rpx !important;
  line-height: 64rpx !important;
  border-radius: 12rpx !important;
}

.theme-scope--dark .login-trigger-btn {
  background: linear-gradient(145deg, #f0a080 0%, #e89572 100%) !important;
}

/* 登录弹窗样式 */
.login-modal {
  visibility: hidden;
  opacity: 0;
  transition: opacity 260ms var(--ease-out);
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.login-modal.show {
  visibility: visible;
  opacity: 1;
}

.login-modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(20, 20, 19, 0.45);
}

.theme-scope--dark .login-modal-mask {
  background: rgba(10, 10, 9, 0.62);
}

.login-modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--surface-solid);
  border-radius: 32rpx 32rpx 0 0;
  padding: 48rpx 48rpx calc(48rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 260ms var(--ease-out);
  border-top: 1rpx solid var(--bg-muted);
  box-shadow: 0 -12rpx 48rpx var(--shadow-sm);
}

.login-modal.show .login-modal-content {
  transform: translateY(0);
}

.modal-header {
  margin-bottom: 48rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
  display: block;
  margin-bottom: 8rpx;
}

.modal-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.login-form {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 40rpx;
  margin-bottom: 64rpx;
}

.avatar-wrapper {
  padding: 0;
  width: 160rpx !important;
  height: 160rpx !important;
  background: var(--bg-muted);
  border-radius: 24rpx;
  position: relative;
}

.modal-avatar {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
}

.avatar-edit-tag {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(20, 20, 19, 0.55);
  color: var(--btn-primary-text);
  font-size: 20rpx;
  padding: 4rpx 0;
  text-align: center;
}

.nickname-input-wrap {
  width: 100%;
  background: var(--bg-soft);
  border-radius: 12rpx;
  padding: 24rpx;
  border: 1rpx solid var(--bg-muted);
}

.input-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 8rpx;
}

.nickname-input {
  color: var(--text);
  font-size: 30rpx;
}

.confirm-login-btn {
  width: 100% !important;
  background: linear-gradient(145deg, #e08568 0%, #d97757 100%) !important;
  color: var(--btn-primary-text) !important;
  height: 96rpx !important;
  line-height: 96rpx !important;
  border-radius: 12rpx !important;
  font-weight: 700 !important;
  font-size: 30rpx !important;
}

.theme-scope--dark .confirm-login-btn {
  background: linear-gradient(145deg, #f0a080 0%, #e89572 100%) !important;
}
