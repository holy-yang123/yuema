.container {
  background-color: #08090A;
  min-height: 100%;
  padding: 32rpx;
  box-sizing: border-box;
}

/* 顶部英雄区 */
.profile-hero {
  background: #101214;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
  border: 1rpx solid #1F1F1F;
}

.profile-hero-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 32rpx 48rpx;
}

.profile-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  border: 1rpx solid #1F1F1F;
  margin-bottom: 24rpx;
  background: #1F1F1F;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: -1rpx;
  margin-bottom: 8rpx;
}

.profile-title {
  font-size: 24rpx;
  color: #28E088;
  font-weight: 500;
}

/* 统计行 */
.profile-stats-row {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  background: rgba(255, 255, 255, 0.02);
  border-top: 1rpx solid #1F1F1F;
}

.profile-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 4rpx;
}

.stat-desc {
  font-size: 22rpx;
  color: #4B4B4B;
}

.stat-divider {
  width: 1rpx;
  height: 40rpx;
  background: #1F1F1F;
}

/* 菜单组 */
.menu-group {
  background: #101214;
  border-radius: 12rpx;
  margin-bottom: 32rpx;
  border: 1rpx solid #1F1F1F;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #1F1F1F;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #1A1D21;
}

.menu-item-text {
  flex: 1;
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 500;
}

.menu-arrow {
  font-size: 24rpx;
  color: #4B4B4B;
}

/* 退出登录 */
.logout-area {
  padding: 32rpx 0;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: transparent;
  color: #FF4D4F;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: 1rpx solid rgba(255, 77, 79, 0.2);
}

.logout-btn:active {
  background: rgba(255, 77, 79, 0.05);
}

.login-trigger-btn {
  margin-top: 24rpx;
  background: #28E088 !important;
  color: #000000 !important;
  font-size: 24rpx !important;
  font-weight: 600 !important;
  padding: 0 40rpx !important;
  height: 64rpx !important;
  line-height: 64rpx !important;
  border-radius: 8rpx !important;
}

/* 登录弹窗样式 */
.login-modal {
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s ease;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.login-modal.show {
  visibility: visible;
  opacity: 1;
}

.login-modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.85);
  backdrop-filter: blur(4rpx);
}

.login-modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #101214;
  border-radius: 32rpx 32rpx 0 0;
  padding: 48rpx 48rpx calc(48rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border-top: 1rpx solid #1F1F1F;
}

.login-modal.show .login-modal-content {
  transform: translateY(0);
}

.modal-header {
  margin-bottom: 48rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  display: block;
  margin-bottom: 8rpx;
}

.modal-subtitle {
  font-size: 24rpx;
  color: #4B4B4B;
}

.login-form {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 40rpx;
  margin-bottom: 64rpx;
}

.avatar-wrapper {
  padding: 0;
  width: 160rpx !important;
  height: 160rpx !important;
  background: #1F1F1F;
  border-radius: 24rpx;
  position: relative;
}

.modal-avatar {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
}

.avatar-edit-tag {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.6);
  color: #ffffff;
  font-size: 20rpx;
  padding: 4rpx 0;
  text-align: center;
}

.nickname-input-wrap {
  width: 100%;
  background: #000000;
  border-radius: 12rpx;
  padding: 24rpx;
  border: 1rpx solid #1F1F1F;
}

.input-label {
  font-size: 22rpx;
  color: #4B4B4B;
  display: block;
  margin-bottom: 8rpx;
}

.nickname-input {
  color: #ffffff;
  font-size: 30rpx;
}

.confirm-login-btn {
  width: 100% !important;
  background: #28E088 !important;
  color: #000000 !important;
  height: 96rpx !important;
  line-height: 96rpx !important;
  border-radius: 12rpx !important;
  font-weight: 700 !important;
  font-size: 30rpx !important;
}
