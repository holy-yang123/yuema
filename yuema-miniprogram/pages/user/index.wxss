.container {
  background-color: #faf9f5;
  min-height: 100%;
  padding: 32rpx;
  box-sizing: border-box;
}

/* 顶部英雄区 */
.profile-hero {
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
  border: 1rpx solid rgba(20, 20, 19, 0.08);
  box-shadow: 0 12rpx 40rpx rgba(20, 20, 19, 0.06);
}

.profile-hero-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 32rpx 48rpx;
}

.profile-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  border: 1rpx solid #e8e6dc;
  margin-bottom: 24rpx;
  background: #e8e6dc;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #141413;
  letter-spacing: -1rpx;
  margin-bottom: 8rpx;
}

.profile-title {
  font-size: 24rpx;
  color: #d97757;
  font-weight: 500;
}

/* 统计行 */
.profile-stats-row {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  background: rgba(232, 230, 220, 0.35);
  border-top: 1rpx solid #e8e6dc;
}

.profile-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #141413;
  margin-bottom: 4rpx;
}

.stat-desc {
  font-size: 22rpx;
  color: #b0aea5;
}

.stat-divider {
  width: 1rpx;
  height: 40rpx;
  background: #e8e6dc;
}

/* 菜单组 */
.menu-group {
  background: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
  border: 1rpx solid rgba(20, 20, 19, 0.08);
  overflow: hidden;
  box-shadow: 0 8rpx 28rpx rgba(20, 20, 19, 0.05);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #e8e6dc;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #faf9f5;
}

.menu-item-text {
  flex: 1;
  font-size: 28rpx;
  color: #141413;
  font-weight: 500;
}

.menu-arrow {
  font-size: 24rpx;
  color: #b0aea5;
}

/* 退出登录 */
.logout-area {
  padding: 32rpx 0;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: transparent;
  color: #FF4D4F;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: 1rpx solid rgba(255, 77, 79, 0.25);
}

.logout-btn:active {
  background: rgba(255, 77, 79, 0.06);
}

.login-trigger-btn {
  margin-top: 24rpx;
  background: linear-gradient(145deg, #e08568 0%, #d97757 100%) !important;
  color: #ffffff !important;
  font-size: 24rpx !important;
  font-weight: 600 !important;
  padding: 0 40rpx !important;
  height: 64rpx !important;
  line-height: 64rpx !important;
  border-radius: 12rpx !important;
}

/* 登录弹窗样式 */
.login-modal {
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s ease;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.login-modal.show {
  visibility: visible;
  opacity: 1;
}

.login-modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(20, 20, 19, 0.45);
  backdrop-filter: blur(4rpx);
}

.login-modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 48rpx 48rpx calc(48rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border-top: 1rpx solid #e8e6dc;
  box-shadow: 0 -12rpx 48rpx rgba(20, 20, 19, 0.1);
}

.login-modal.show .login-modal-content {
  transform: translateY(0);
}

.modal-header {
  margin-bottom: 48rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #141413;
  display: block;
  margin-bottom: 8rpx;
}

.modal-subtitle {
  font-size: 24rpx;
  color: #b0aea5;
}

.login-form {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 40rpx;
  margin-bottom: 64rpx;
}

.avatar-wrapper {
  padding: 0;
  width: 160rpx !important;
  height: 160rpx !important;
  background: #e8e6dc;
  border-radius: 24rpx;
  position: relative;
}

.modal-avatar {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
}

.avatar-edit-tag {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(20, 20, 19, 0.55);
  color: #ffffff;
  font-size: 20rpx;
  padding: 4rpx 0;
  text-align: center;
}

.nickname-input-wrap {
  width: 100%;
  background: #faf9f5;
  border-radius: 12rpx;
  padding: 24rpx;
  border: 1rpx solid #e8e6dc;
}

.input-label {
  font-size: 22rpx;
  color: #b0aea5;
  display: block;
  margin-bottom: 8rpx;
}

.nickname-input {
  color: #141413;
  font-size: 30rpx;
}

.confirm-login-btn {
  width: 100% !important;
  background: linear-gradient(145deg, #e08568 0%, #d97757 100%) !important;
  color: #ffffff !important;
  height: 96rpx !important;
  line-height: 96rpx !important;
  border-radius: 12rpx !important;
  font-weight: 700 !important;
  font-size: 30rpx !important;
}
