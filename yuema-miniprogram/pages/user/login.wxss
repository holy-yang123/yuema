.login-wrap {
  min-height: 100%;
  box-sizing: border-box;
  padding: 120rpx 48rpx 64rpx;
  background-color: #08090A;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.login-brand {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 80rpx;
}

.login-title {
  font-size: 56rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 4rpx;
  margin-bottom: 24rpx;
}

.login-desc {
  font-size: 28rpx;
  color: #8a9096;
  text-align: center;
  line-height: 1.5;
}

.login-btn {
  margin-top: auto;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #08090a;
  background: linear-gradient(135deg, #4ae8b8 0%, #28e088 100%);
  border: none;
}

.login-btn::after {
  border: none;
}
