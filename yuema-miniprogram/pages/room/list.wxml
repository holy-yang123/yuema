<page-meta root-background-color="{{themeMeta.rootBg}}" background-color="{{themeMeta.bg}}" background-color-bottom="{{themeMeta.bgBottom}}" background-text-style="{{themeMeta.textStyle}}" />
<!-- 与「我的」一致：锁 page 滚动，避免整页原生滚动条；列表仍由内层 scroll-view 滚动 -->
<view class="page-native-scroll-host">
  <view class="page-native-scroll-body">
<view class="{{themeScopeClass}}">
<view class="container">
  <view class="header">
    <view class="search-box">
      <icon type="search" size="18" color="{{themeSearchIconColor}}"></icon>
      <input placeholder="搜索房间号、玩法" placeholder-class="placeholder-style" bindinput="onSearchInput" />
    </view>
    <view class="filter-tabs">
      <view class="tab {{currentTab === 'all' ? 'active' : ''}}" bindtap="switchTab" data-tab="all">全部</view>
      <view class="tab {{currentTab === 'waiting' ? 'active' : ''}}" bindtap="switchTab" data-tab="waiting">等待中</view>
      <view class="tab {{currentTab === 'playing' ? 'active' : ''}}" bindtap="switchTab" data-tab="playing">进行中</view>
    </view>
  </view>

  <!-- hall-room-scroll：与首页推荐区外层区分类名，避免样式语义混淆 -->
  <!-- enhanced：WebView 下 show-scrollbar 仅在与 enhanced 同开时生效（官方文档），用于真正隐藏纵向滚动条 -->
  <scroll-view scroll-y enhanced="{{true}}" show-scrollbar="{{false}}" class="hall-room-scroll" style="height: {{scrollViewHeightPx}}px" refresher-enabled refresher-background="{{themeMeta.bg}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh">
    <view class="room-card" wx:for="{{filteredRooms}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <view class="room-card-header">
        <view class="room-card-left">
          <text class="room-no-text">#{{item.roomNo}}</text>
          <text class="room-game-type">{{gameTypeMap[item.gameType]}}</text>
        </view>
        <view class="status-pill {{item.status === 0 ? 'status-waiting' : item.status === 1 ? 'status-playing' : 'status-ended'}}">
          <view class="status-dot"></view>
          <text>{{item.status === 0 ? '等待中' : item.status === 1 ? '进行中' : '已结束'}}</text>
        </view>
      </view>
      <view class="room-card-body">
        <view class="room-meta-row">
          <text class="meta-label">人数</text>
          <text class="meta-value">{{item.currentPlayers}}/{{item.maxPlayers}}</text>
        </view>
        <view class="room-meta-row" wx:if="{{item.scheduleDisplayStart}}">
          <text class="meta-label">开始范围</text>
          <text class="meta-value">{{item.scheduleDisplayStart}}</text>
        </view>
        <view class="room-meta-row" wx:if="{{item.scheduleDisplayDuration}}">
          <text class="meta-label">预计时长</text>
          <text class="meta-value">{{item.scheduleDisplayDuration}}</text>
        </view>
        <view class="room-meta-row" wx:if="{{item.venueName}}">
          <text class="meta-label">场地</text>
          <text class="meta-value venue-name-text">{{item.venueName}}</text>
        </view>
        <view class="room-meta-row" wx:if="{{item.remark}}">
          <text class="meta-label">备注</text>
          <text class="meta-value room-card-remark">{{item.remark}}</text>
        </view>
        <!-- 与首页推荐牌局同一套 markup：规则标签 -->
        <view class="room-rule-tags" wx:if="{{item.ruleCardTags && item.ruleCardTags.length}}">
          <text class="room-rule-tag" wx:for="{{item.ruleCardTags}}" wx:for-item="tag" wx:key="key">{{tag.label}}</text>
        </view>
      </view>
      <view class="room-card-footer" wx:if="{{item.status === 0}}">
        <block wx:if="{{currentUserId && item.creatorId === currentUserId}}">
          <button class="room-secondary-btn" size="mini" catchtap="goEditRoom" data-id="{{item.id}}">编辑</button>
          <button class="room-danger-btn" size="mini" catchtap="confirmDeleteRoom" data-id="{{item.id}}">删除</button>
        </block>
        <button wx:elif="{{!isMyRooms}}" class="room-join-btn" size="mini" catchtap="onJoin" data-id="{{item.id}}">加入</button>
      </view>
    </view>

    <view class="empty-state" wx:if="{{filteredRooms.length === 0}}">
      <image src="/images/empty.png" mode="aspectFit" wx:if="{{hasEmptyImage}}"></image>
      <text>暂无相关牌局</text>
    </view>
  </scroll-view>

  <view class="create-fab" bindtap="goToCreate">
    <text class="plus">+</text>
  </view>
</view>
</view>
  </view>
</view>
