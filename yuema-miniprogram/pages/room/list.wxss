.container {
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
  background-color: #08090A;
  box-sizing: border-box;
}

.header {
  flex-shrink: 0;
  padding: 32rpx;
  background-color: #08090A;
  position: sticky;
  top: 0;
  z-index: 10;
  border-bottom: 1rpx solid #1F1F1F;
}

.search-box {
  display: flex;
  align-items: center;
  background: #101214;
  border-radius: 8rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 32rpx;
  border: 1rpx solid #1F1F1F;
}

.search-box input {
  flex: 1;
  margin-left: 20rpx;
  color: #ffffff;
  font-size: 28rpx;
}

.placeholder-style {
  color: #4B4B4B;
}

.filter-tabs {
  display: flex;
  gap: 40rpx;
}

.tab {
  color: #8A9096;
  font-size: 28rpx;
  padding: 8rpx 0;
  position: relative;
  transition: all 0.2s ease;
}

.tab.active {
  color: #28E088;
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: -4rpx;
  left: 0;
  right: 0;
  height: 2rpx;
  background: #28E088;
}

.room-list {
  padding: 32rpx;
  width: 100%;
  box-sizing: border-box;
  background-color: #08090A;
}

.room-card {
  width: 100%;
  background: #101214;
  border-radius: 12rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  border: 1rpx solid #1F1F1F;
  transition: border-color 0.2s ease;
}

.room-card:active {
  border-color: #28E088;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.room-no {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
}

.status-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-weight: 500;
}

.status-tag.waiting {
  background: rgba(40, 224, 136, 0.1);
  color: #28E088;
}

.status-tag.playing {
  background: rgba(138, 144, 150, 0.1);
  color: #8A9096;
}

.status-tag.ended {
  background: rgba(255, 77, 79, 0.08);
  color: #ff7875;
}

.card-body {
  margin-bottom: 32rpx;
}

.info-row {
  display: flex;
  margin-bottom: 16rpx;
  font-size: 26rpx;
}

.label {
  color: #8A9096;
  width: 120rpx;
}

.value {
  color: #ffffff;
  flex: 1;
}

.card-footer {
  display: flex;
  justify-content: flex-end;
  border-top: 1rpx solid #1F1F1F;
  padding-top: 24rpx;
}

.join-btn {
  margin: 0 !important;
  background: #28E088 !important;
  color: #000000 !important;
  border-radius: 8rpx !important;
  font-size: 26rpx !important;
  height: 64rpx !important;
  padding: 0 32rpx !important;
  font-weight: 600 !important;
}

.create-fab {
  position: fixed;
  right: 48rpx;
  bottom: 48rpx;
  width: 104rpx;
  height: 104rpx;
  background: #28E088;
  border-radius: 12rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 12rpx 32rpx rgba(40, 224, 136, 0.3);
  z-index: 99;
}

.plus {
  color: #000000;
  font-size: 56rpx;
  font-weight: 300;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
  color: #4B4B4B;
  font-size: 28rpx;
}
