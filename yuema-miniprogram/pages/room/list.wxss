.container {
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
  background-color: var(--bg);
  box-sizing: border-box;
}

.header {
  flex-shrink: 0;
  padding: 32rpx;
  background-color: var(--bg);
  position: sticky;
  top: 0;
  z-index: 10;
  border-bottom: 1rpx solid var(--bg-muted);
}

.search-box {
  display: flex;
  align-items: center;
  background: var(--surface-solid);
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 32rpx;
  border: 1rpx solid rgba(20, 20, 19, 0.1);
  box-shadow: 0 4rpx 16rpx rgba(20, 20, 19, 0.05);
}

.search-box input {
  flex: 1;
  margin-left: 20rpx;
  color: var(--text);
  font-size: 28rpx;
}

.placeholder-style {
  color: var(--text-secondary);
}

.filter-tabs {
  display: flex;
  gap: 40rpx;
}

.tab {
  color: var(--text-secondary);
  font-size: 28rpx;
  padding: 8rpx 0;
  position: relative;
  transition: all 0.2s ease;
}

.tab.active {
  color: var(--accent-orange);
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: -4rpx;
  left: 0;
  right: 0;
  height: 2rpx;
  background: var(--accent-orange);
}

.room-list {
  padding: 32rpx;
  width: 100%;
  box-sizing: border-box;
  background-color: var(--bg);
}

.room-card {
  width: 100%;
  background: var(--surface-solid);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  border: 1rpx solid rgba(20, 20, 19, 0.08);
  box-shadow: 0 8rpx 32rpx rgba(20, 20, 19, 0.06);
  transition: border-color 0.2s ease;
}

.room-card:active {
  border-color: rgba(217, 119, 87, 0.35);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.room-no {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.status-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-weight: 500;
}

.status-tag.waiting {
  background: rgba(217, 119, 87, 0.12);
  color: var(--tag-primary-fg);
}

.status-tag.playing {
  background: rgba(176, 174, 165, 0.18);
  color: var(--text-secondary);
}

.status-tag.ended {
  background: rgba(255, 77, 79, 0.08);
  color: var(--danger);
}

.card-body {
  margin-bottom: 32rpx;
}

.info-row {
  display: flex;
  margin-bottom: 16rpx;
  font-size: 26rpx;
}

.label {
  color: var(--text-secondary);
  width: 120rpx;
}

.value {
  color: var(--text);
  flex: 1;
}

.card-footer {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
  border-top: 1rpx solid var(--bg-muted);
  padding-top: 24rpx;
}

/* 本人等待中牌局：编辑 / 删除 */
.owner-btn {
  margin: 0 !important;
  border-radius: 10rpx !important;
  font-size: 26rpx !important;
  height: 64rpx !important;
  padding: 0 28rpx !important;
  font-weight: 600 !important;
}

.owner-btn-outline {
  background: var(--surface-solid) !important;
  color: var(--text-secondary) !important;
  border: 1rpx solid rgba(20, 20, 19, 0.15) !important;
}

.owner-btn-danger {
  background: rgba(255, 77, 79, 0.12) !important;
  color: var(--danger) !important;
  border: 1rpx solid rgba(207, 19, 34, 0.35) !important;
}

.join-btn {
  margin: 0 !important;
  background: linear-gradient(145deg, #e08568 0%, var(--accent-orange) 100%) !important;
  color: var(--btn-primary-text) !important;
  border-radius: 10rpx !important;
  font-size: 26rpx !important;
  height: 64rpx !important;
  padding: 0 32rpx !important;
  font-weight: 600 !important;
}

.create-fab {
  position: fixed;
  right: 48rpx;
  bottom: 48rpx;
  width: 104rpx;
  height: 104rpx;
  background: var(--accent-orange);
  border-radius: 16rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 12rpx 32rpx rgba(217, 119, 87, 0.35);
  z-index: 99;
}

.plus {
  color: var(--btn-primary-text);
  font-size: 56rpx;
  font-weight: 300;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
  color: var(--text-secondary);
  font-size: 28rpx;
}
