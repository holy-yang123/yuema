.container {
  background-color: #08090A;
  min-height: 100%;
  padding-bottom: 160rpx;
  box-sizing: border-box;
}

.room-header-card {
  background: #101214;
  border-radius: 12rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #1F1F1F;
}

.room-header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.room-id {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: -1rpx;
}

.status-pill {
  display: flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.status-waiting { background: rgba(40, 224, 136, 0.1); color: #28E088; }
.status-waiting .status-dot { background: #28E088; }
.status-playing { background: rgba(138, 144, 150, 0.1); color: #8A9096; }
.status-playing .status-dot { background: #8A9096; }

.room-meta-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.meta-cell {
  background: #000000;
  border: 1rpx solid #1F1F1F;
  border-radius: 8rpx;
  padding: 24rpx;
}

.meta-cell-label {
  font-size: 22rpx;
  color: #4B4B4B;
  display: block;
  margin-bottom: 8rpx;
}

.meta-cell-value {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 600;
}

.card-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 32rpx;
}

.card-title-badge {
  font-size: 20rpx;
  color: #28E088;
  background: rgba(40, 224, 136, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-left: 16rpx;
  font-weight: 500;
}

.member-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.member-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #000000;
  border: 1rpx solid #1F1F1F;
  border-radius: 8rpx;
}

.member-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  background: #1F1F1F;
}

.member-name {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 500;
}

.member-role {
  font-size: 22rpx;
  color: #4B4B4B;
}

.member-role.is-owner {
  color: #28E088;
}

.empty-slot {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed #1F1F1F;
}

.score-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #1F1F1F;
}

.score-value {
  font-size: 36rpx;
  font-weight: 700;
}

.score-win { color: #28E088; }
.score-lose { color: #FF4D4F; }

.action-bar {
  display: flex;
  gap: 24rpx;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: #000000;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  border-top: 1rpx solid #1F1F1F;
  z-index: 100;
}

.action-btn {
  flex: 1;
  background: #28E088 !important;
  color: #000000 !important;
  font-weight: 600 !important;
  border-radius: 8rpx !important;
}

.action-btn-secondary {
  background: #101214 !important;
  color: #ffffff !important;
  border: 1rpx solid #1F1F1F !important;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.mt-20 {
  margin-top: 20rpx;
}

.score-actions {
  margin-top: 16rpx;
}

.action-btn-full {
  width: 100%;
}

.btn-danger {
  background: rgba(255, 77, 79, 0.15) !important;
  color: #ff4d4f !important;
  border: 1rpx solid rgba(255, 77, 79, 0.35) !important;
}

.divider {
  height: 1rpx;
  background: #1f1f1f;
  margin: 24rpx 0;
}

.settlement-label {
  font-size: 26rpx;
  color: #8a9096;
  display: block;
  margin-bottom: 16rpx;
}

.settlement-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #1f1f1f;
}

.amount-win { color: #28e088; }
.amount-lose { color: #ff4d4f; }

.member-avatar-wrap {
  position: relative;
  margin-right: 24rpx;
}

.seat-badge {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  font-size: 18rpx;
  background: #28e088;
  color: #000;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

.member-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.member-hint {
  font-size: 22rpx;
  color: #4b4b4b;
  margin-top: 16rpx;
}

.detail-page {
  padding-bottom: 200rpx;
}

.modify-banner .modify-hint {
  font-size: 24rpx;
  color: #8a9096;
  margin-bottom: 16rpx;
}

.modify-round-tag {
  font-size: 22rpx;
  color: #28e088;
}

.modify-score-rows {
  margin: 16rpx 0;
}

.modify-score-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
  font-size: 28rpx;
}

.modify-sc.pos { color: #28e088; }
.modify-sc.neg { color: #ff4d4f; }

.modify-vote-meta {
  font-size: 24rpx;
  color: #8a9096;
}

.modify-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.modify-voted {
  font-size: 24rpx;
  color: #8a9096;
  margin-top: 12rpx;
}

.btn-sm {
  height: 72rpx !important;
  font-size: 26rpx !important;
  flex: 1;
}

.danger-outline {
  border-color: rgba(255, 77, 79, 0.4) !important;
  color: #ff4d4f !important;
}

.fab-chat,
.fab-invite {
  position: fixed;
  right: 32rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(40, 224, 136, 0.92);
  color: #000;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 90;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.35);
}

.fab-chat {
  bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.fab-invite {
  bottom: calc(310rpx + env(safe-area-inset-bottom));
}

.chat-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 120;
}

.chat-drawer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 55vh;
  background: #0e1014;
  border-top: 1rpx solid #1f1f1f;
  z-index: 130;
  transform: translateY(100%);
  transition: transform 0.25s ease;
  display: flex;
  flex-direction: column;
}

.chat-drawer.open {
  transform: translateY(0);
}

.chat-drawer-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #1f1f1f;
}

.chat-title {
  font-size: 30rpx;
  font-weight: 600;
}

.chat-close {
  font-size: 28rpx;
  color: #28e088;
}

.chat-scroll {
  flex: 1;
  padding: 16rpx 32rpx;
  overflow-y: auto;
}

.chat-msg {
  margin-bottom: 20rpx;
}

.chat-msg-meta {
  font-size: 22rpx;
  color: #6b7280;
  display: block;
  margin-bottom: 6rpx;
}

.chat-msg-body {
  font-size: 28rpx;
  color: #f4f5f7;
  line-height: 1.45;
}

.chat-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid #1f1f1f;
  background: #08090a;
}

.chat-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  background: #000;
  border: 1rpx solid #1f1f1f;
  border-radius: 12rpx;
  color: #fff;
  font-size: 28rpx;
}

.chat-send {
  width: 140rpx !important;
  height: 72rpx !important;
  font-size: 26rpx !important;
}

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 140;
}

.invite-panel {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #101214;
  border: 1rpx solid #1f1f1f;
  border-radius: 16rpx;
  padding: 32rpx;
  z-index: 150;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.invite-title {
  font-size: 30rpx;
  font-weight: 600;
}

.invite-qr {
  width: 400rpx;
  height: 400rpx;
  background: #fff;
  border-radius: 8rpx;
}

.invite-tip {
  font-size: 22rpx;
  color: #8a9096;
  text-align: center;
}
