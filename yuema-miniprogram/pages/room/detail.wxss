.container {
  background-color: #08090A;
  min-height: 100%;
  padding-bottom: 160rpx;
  box-sizing: border-box;
}

.room-header-card {
  background: #101214;
  border-radius: 12rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #1F1F1F;
}

.room-header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.room-id {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: -1rpx;
}

.status-pill {
  display: flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.status-waiting { background: rgba(40, 224, 136, 0.1); color: #28E088; }
.status-waiting .status-dot { background: #28E088; }
.status-playing { background: rgba(138, 144, 150, 0.1); color: #8A9096; }
.status-playing .status-dot { background: #8A9096; }

.room-meta-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.meta-cell {
  background: #000000;
  border: 1rpx solid #1F1F1F;
  border-radius: 8rpx;
  padding: 24rpx;
}

.meta-cell-label {
  font-size: 22rpx;
  color: #4B4B4B;
  display: block;
  margin-bottom: 8rpx;
}

.meta-cell-value {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 600;
}

.card-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 32rpx;
}

.card-title-badge {
  font-size: 20rpx;
  color: #28E088;
  background: rgba(40, 224, 136, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-left: 16rpx;
  font-weight: 500;
}

.member-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.member-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #000000;
  border: 1rpx solid #1F1F1F;
  border-radius: 8rpx;
}

.member-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  background: #1F1F1F;
  margin-right: 24rpx;
}

.member-name {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 500;
}

.member-role {
  font-size: 22rpx;
  color: #4B4B4B;
}

.member-role.is-owner {
  color: #28E088;
}

.empty-slot {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed #1F1F1F;
}

.score-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #1F1F1F;
}

.score-value {
  font-size: 36rpx;
  font-weight: 700;
}

.score-win { color: #28E088; }
.score-lose { color: #FF4D4F; }

.action-bar {
  display: flex;
  gap: 24rpx;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: #000000;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  border-top: 1rpx solid #1F1F1F;
  z-index: 100;
}

.action-btn {
  flex: 1;
  background: #28E088 !important;
  color: #000000 !important;
  font-weight: 600 !important;
  border-radius: 8rpx !important;
}

.action-btn-secondary {
  background: #101214 !important;
  color: #ffffff !important;
  border: 1rpx solid #1F1F1F !important;
}
