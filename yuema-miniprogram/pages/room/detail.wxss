/* ========================================
   牌局详情 - SOLO 深色风格
   ======================================== */

.room-header-card {
  background: #1a1a1a;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.room-header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.room-id {
  font-size: 36rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 1rpx;
}

/* 状态胶囊（复用首页样式） */
.status-pill {
  display: flex;
  align-items: center;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.status-waiting { background: rgba(16, 185, 129, 0.12); color: #34d399; }
.status-waiting .status-dot { background: #34d399; }
.status-playing { background: rgba(251, 191, 36, 0.12); color: #fbbf24; }
.status-playing .status-dot { background: #fbbf24; }
.status-ended { background: rgba(255, 255, 255, 0.06); color: rgba(255, 255, 255, 0.4); }
.status-ended .status-dot { background: rgba(255, 255, 255, 0.3); }

/* 信息网格 */
.room-meta-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.meta-cell {
  flex: 1;
  min-width: 45%;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 16rpx;
  padding: 20rpx;
}

.meta-cell-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.3);
  display: block;
  margin-bottom: 6rpx;
}

.meta-cell-value {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 600;
}

/* 卡片标题 */
.card-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 24rpx;
}

.card-title-badge {
  font-size: 22rpx;
  color: #a78bfa;
  background: rgba(108, 92, 231, 0.15);
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  margin-left: 12rpx;
  font-weight: 500;
}

/* 成员列表 */
.member-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.member-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 16rpx;
}

.member-avatar-wrap {
  position: relative;
  margin-right: 20rpx;
}

.member-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.seat-badge {
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #6C5CE7;
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.member-info {
  flex: 1;
}

.member-name {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
  display: block;
}

.member-role {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.3);
}

.member-role.is-owner {
  color: #a78bfa;
}

.member-empty {
  opacity: 0.4;
}

.empty-slot {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed rgba(255, 255, 255, 0.15);
}

.empty-slot-text {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.2);
}

.empty-info {
  color: rgba(255, 255, 255, 0.25);
  font-size: 26rpx;
}

/* 分数列表 */
.round-badge {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  background: rgba(255, 255, 255, 0.06);
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.score-list {
  margin-bottom: 24rpx;
}

.score-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.04);
}

.score-item:last-child {
  border-bottom: none;
}

.score-player {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.75);
}

.score-value {
  font-size: 36rpx;
  font-weight: 700;
}

.score-win { color: #34d399; }
.score-lose { color: #f87171; }

/* 结算 */
.settlement-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.4);
  font-weight: 500;
  display: block;
  margin-bottom: 16rpx;
}

.settlement-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.settlement-name {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

.settlement-amount {
  font-size: 28rpx;
  font-weight: 600;
}

.amount-win { color: #34d399; }
.amount-lose { color: #f87171; }

/* 操作按钮 */
.action-bar {
  display: flex;
  gap: 20rpx;
  padding: 24rpx;
  background: #0f0f0f;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
}

.action-btn {
  flex: 1;
}

.action-btn-full {
  width: 100%;
}
