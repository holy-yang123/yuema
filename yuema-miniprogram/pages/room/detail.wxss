.container {
  background-color: var(--bg);
  min-height: 100%;
  padding-bottom: 160rpx;
  box-sizing: border-box;
}

.room-header-card {
  background: var(--surface-solid);
  border-radius: 12rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--bg-muted);
}

/* 详情页：房主编辑/删除入口 */
.owner-room-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.owner-link-btn {
  margin: 0 !important;
  padding: 0 !important;
  background: transparent !important;
  border: none !important;
  font-size: 26rpx !important;
  color: var(--accent-orange) !important;
  font-weight: 500 !important;
  line-height: 1.4 !important;
}

.owner-link-btn.danger {
  color: var(--danger) !important;
}

.owner-link-btn::after {
  border: none;
}

.owner-link-sep {
  font-size: 22rpx;
  color: var(--bg-muted);
}

.room-header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.room-id-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.room-id {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: -1rpx;
}

.copy-room-no {
  font-size: 24rpx;
  color: var(--accent-orange);
  padding: 6rpx 16rpx;
  border: 1rpx solid rgba(217, 119, 87, 0.35);
  border-radius: 8rpx;
}

.status-pill {
  display: flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.status-waiting { background: rgba(217, 119, 87, 0.12); color: var(--tag-primary-fg); }
.status-waiting .status-dot { background: var(--accent-orange); }
.status-playing { background: rgba(176, 174, 165, 0.18); color: var(--text-secondary); }
.status-playing .status-dot { background: var(--text-secondary); }

.room-meta-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.meta-cell {
  background: var(--bg);
  border: 1rpx solid var(--bg-muted);
  border-radius: 8rpx;
  padding: 24rpx;
}

.meta-cell-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 8rpx;
}

.room-rules-remark {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--bg-muted);
}

.rule-block,
.remark-block {
  margin-bottom: 20rpx;
}

.rule-block:last-child,
.remark-block:last-child {
  margin-bottom: 0;
}

.rule-block-title {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.rule-tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.rule-tag {
  font-size: 22rpx;
  color: var(--tag-primary-fg);
  background: rgba(217, 119, 87, 0.12);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.rule-custom-lines {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.rule-custom-line {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.room-remark-body {
  display: block;
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.5;
  word-break: break-all;
}

.meta-cell-value {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 600;
}

.card-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 32rpx;
}

.card-title-badge {
  font-size: 20rpx;
  color: var(--tag-primary-fg);
  background: rgba(217, 119, 87, 0.12);
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-left: 16rpx;
  font-weight: 500;
}

.member-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.member-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: var(--bg);
  border: 1rpx solid var(--bg-muted);
  border-radius: 8rpx;
}

.member-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  background: var(--bg-muted);
}

.member-name {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 500;
}

.member-role {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.member-role.is-owner {
  color: var(--accent-orange);
}

.empty-slot {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed var(--bg-muted);
}

.score-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--bg-muted);
}

.score-value {
  font-size: 36rpx;
  font-weight: 700;
}

.score-win { color: var(--accent-green); }
.score-lose { color: var(--danger); }

.action-bar {
  display: flex;
  gap: 24rpx;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: var(--surface-solid);
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  border-top: 1rpx solid var(--bg-muted);
  z-index: 100;
  box-shadow: 0 -8rpx 32rpx rgba(20, 20, 19, 0.06);
}

.action-btn {
  flex: 1;
  background: linear-gradient(145deg, #e08568 0%, var(--accent-orange) 100%) !important;
  color: var(--btn-primary-text) !important;
  font-weight: 600 !important;
  border-radius: 10rpx !important;
}

.action-btn-secondary {
  background: var(--bg) !important;
  color: var(--text) !important;
  border: 1rpx solid var(--bg-muted) !important;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.mt-20 {
  margin-top: 20rpx;
}

.score-actions {
  margin-top: 16rpx;
}

.action-btn-full {
  width: 100%;
}

.btn-danger {
  background: rgba(255, 77, 79, 0.15) !important;
  color: var(--danger) !important;
  border: 1rpx solid rgba(255, 77, 79, 0.35) !important;
}

.divider {
  height: 1rpx;
  background: var(--bg-muted);
  margin: 24rpx 0;
}

.settlement-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 16rpx;
}

.settlement-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--bg-muted);
}

.amount-win { color: var(--accent-green); }
.amount-lose { color: var(--danger); }

.member-avatar-wrap {
  position: relative;
  margin-right: 24rpx;
}

.seat-badge {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  font-size: 18rpx;
  background: var(--accent-orange);
  color: var(--btn-primary-text);
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

.member-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.member-hint {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 16rpx;
}

.detail-page {
  padding-bottom: 200rpx;
}

.modify-banner .modify-hint {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}

.modify-round-tag {
  font-size: 22rpx;
  color: var(--accent-green);
}

.modify-score-rows {
  margin: 16rpx 0;
}

.modify-score-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(20, 20, 19, 0.08);
  font-size: 28rpx;
}

.modify-sc.pos { color: var(--accent-green); }
.modify-sc.neg { color: var(--danger); }

.modify-vote-meta {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.modify-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.modify-voted {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 12rpx;
}

.btn-sm {
  height: 72rpx !important;
  font-size: 26rpx !important;
  flex: 1;
}

.danger-outline {
  border-color: rgba(255, 77, 79, 0.4) !important;
  color: var(--danger) !important;
}

.fab-chat,
.fab-invite {
  position: fixed;
  right: 32rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(217, 119, 87, 0.95);
  color: var(--btn-primary-text);
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 90;
  box-shadow: 0 8rpx 24rpx rgba(217, 119, 87, 0.35);
}

.fab-chat {
  bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.fab-invite {
  bottom: calc(310rpx + env(safe-area-inset-bottom));
}

.chat-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 120;
}

.chat-drawer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 55vh;
  background: var(--bg);
  border-top: 1rpx solid var(--bg-muted);
  z-index: 130;
  transform: translateY(100%);
  transition: transform 0.25s ease;
  display: flex;
  flex-direction: column;
}

.chat-drawer.open {
  transform: translateY(0);
}

.chat-drawer-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--bg-muted);
}

.chat-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.chat-close {
  font-size: 28rpx;
  color: var(--accent-orange);
}

.chat-scroll {
  flex: 1;
  padding: 16rpx 32rpx;
  overflow-y: auto;
}

.chat-msg {
  margin-bottom: 20rpx;
}

.chat-msg-meta {
  font-size: 22rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 6rpx;
}

.chat-msg-body {
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.45;
}

.chat-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid var(--bg-muted);
  background: var(--bg);
}

.chat-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  background: var(--surface-solid);
  border: 1rpx solid var(--bg-muted);
  border-radius: 12rpx;
  color: var(--text);
  font-size: 28rpx;
}

.chat-send {
  width: 140rpx !important;
  height: 72rpx !important;
  font-size: 26rpx !important;
}

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 140;
}

.invite-panel {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  top: 50%;
  transform: translateY(-50%);
  background: var(--surface-solid);
  border: 1rpx solid var(--bg-muted);
  border-radius: 16rpx;
  padding: 32rpx;
  z-index: 150;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.invite-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.invite-qr {
  width: 400rpx;
  height: 400rpx;
  background: var(--surface-solid);
  border-radius: 8rpx;
}

.invite-tip {
  font-size: 22rpx;
  color: var(--text-secondary);
  text-align: center;
}
