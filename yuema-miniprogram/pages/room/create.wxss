.container {
  background-color: var(--bg);
  min-height: 100%;
  padding: 32rpx;
  box-sizing: border-box;
}

.form-container {
  background: var(--surface-solid);
  border-radius: 16rpx;
  padding: 0 32rpx;
  border: 1rpx solid rgba(20, 20, 19, 0.08);
  box-shadow: 0 8rpx 28rpx rgba(20, 20, 19, 0.06);
}

.form-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 0;
  border-bottom: 1rpx solid var(--bg-muted);
}

/* 开关行固定右侧占位，减少切换时布局抖动 */
.form-item-switch .label {
  flex: 1;
  min-width: 0;
  padding-right: 24rpx;
}

.rule-switch-wrap {
  flex-shrink: 0;
  width: 102rpx;
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

.form-item.form-item-column {
  flex-direction: column;
  align-items: stretch;
}

.form-item-column:last-child {
  border-bottom: none;
}

/* 计划开始：日期+时间并排，与单列 label 对齐 */
.form-item-schedule .label {
  align-self: flex-start;
  margin-bottom: 16rpx;
}

.schedule-dt-row {
  display: flex;
  flex-direction: row;
  gap: 24rpx;
  width: 100%;
  box-sizing: border-box;
}

.schedule-picker-half {
  flex: 1;
  min-width: 0;
}

.rules-section-title {
  padding: 32rpx 0 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  border-bottom: 1rpx solid var(--bg-muted);
}

.custom-rules-wrap {
  padding: 24rpx 0 32rpx;
  border-bottom: 1rpx solid var(--bg-muted);
}

.custom-rules-hint {
  font-size: 22rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 16rpx;
}

.custom-line-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--bg-soft);
}

.custom-line-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--text);
  margin-right: 16rpx;
  word-break: break-all;
}

.custom-line-del {
  font-size: 24rpx;
  color: var(--accent-orange);
  flex-shrink: 0;
}

.custom-add-block {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 20rpx;
  margin-top: 16rpx;
}

.custom-add-input {
  width: 100%;
  min-height: 88rpx;
  box-sizing: border-box;
  background: var(--bg);
  border: 1rpx solid var(--bg-muted);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.45;
}

.custom-add-btn {
  align-self: flex-end;
  margin: 0 !important;
  padding: 0 40rpx !important;
  height: 72rpx !important;
  line-height: 72rpx !important;
  font-size: 28rpx !important;
  background: var(--bg) !important;
  color: var(--accent-orange) !important;
  border: 1rpx solid rgba(217, 119, 87, 0.45) !important;
  border-radius: 12rpx !important;
}

.custom-add-btn::after {
  border: none;
}

.remark-area {
  margin-top: 16rpx;
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx;
  box-sizing: border-box;
  background: var(--bg);
  border: 1rpx solid var(--bg-muted);
  border-radius: 8rpx;
  font-size: 28rpx;
  color: var(--text);
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  color: var(--text);
  font-size: 28rpx;
  font-weight: 500;
}

.picker-value {
  color: var(--accent-orange);
  font-size: 28rpx;
  font-weight: 500;
}

.picker-value.placeholder {
  color: var(--text-secondary);
}

.btn-area {
  margin-top: 64rpx;
}

.submit-btn {
  background: linear-gradient(145deg, #e08568 0%, var(--accent-orange) 100%) !important;
  color: var(--btn-primary-text) !important;
  border-radius: 12rpx !important;
  height: 88rpx !important;
  line-height: 88rpx !important;
  font-size: 30rpx !important;
  font-weight: 600 !important;
}

.submit-btn:active {
  opacity: 0.88;
}

/* 四川加底/加番单选：纵向排列避免挤占开关行 */
.form-item-jia-radio {
  flex-direction: column;
  align-items: stretch;
  gap: 20rpx;
}

.form-item-jia-radio .label {
  align-self: flex-start;
}

.jia-radio-group {
  display: flex;
  flex-wrap: wrap;
  gap: 28rpx 36rpx;
}

.jia-radio-item {
  display: inline-flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--text);
}
