.container {
  background-color: #faf9f5;
  min-height: 100%;
  padding: 32rpx;
  box-sizing: border-box;
}

.form-container {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 0 32rpx;
  border: 1rpx solid rgba(20, 20, 19, 0.08);
  box-shadow: 0 8rpx 28rpx rgba(20, 20, 19, 0.06);
}

.form-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 0;
  border-bottom: 1rpx solid #e8e6dc;
}

.form-item.form-item-column {
  flex-direction: column;
  align-items: stretch;
}

.form-item-column:last-child {
  border-bottom: none;
}

.rules-section-title {
  padding: 32rpx 0 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #141413;
  border-bottom: 1rpx solid #e8e6dc;
}

.custom-rules-wrap {
  padding: 24rpx 0 32rpx;
  border-bottom: 1rpx solid #e8e6dc;
}

.custom-rules-hint {
  font-size: 22rpx;
  color: #b0aea5;
  display: block;
  margin-bottom: 16rpx;
}

.custom-line-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0efe8;
}

.custom-line-text {
  flex: 1;
  font-size: 26rpx;
  color: #141413;
  margin-right: 16rpx;
  word-break: break-all;
}

.custom-line-del {
  font-size: 24rpx;
  color: #d97757;
  flex-shrink: 0;
}

.custom-add-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.custom-add-input {
  flex: 1;
  background: #faf9f5;
  border: 1rpx solid #e8e6dc;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
}

.custom-add-btn {
  margin: 0 !important;
  background: #faf9f5 !important;
  color: #d97757 !important;
  border: 1rpx solid rgba(217, 119, 87, 0.45) !important;
}

.remark-area {
  margin-top: 16rpx;
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx;
  box-sizing: border-box;
  background: #faf9f5;
  border: 1rpx solid #e8e6dc;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #141413;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  color: #141413;
  font-size: 28rpx;
  font-weight: 500;
}

.picker-value {
  color: #d97757;
  font-size: 28rpx;
  font-weight: 500;
}

.picker-value.placeholder {
  color: #b0aea5;
}

.btn-area {
  margin-top: 64rpx;
}

.submit-btn {
  background: linear-gradient(145deg, #e08568 0%, #d97757 100%) !important;
  color: #ffffff !important;
  border-radius: 12rpx !important;
  height: 88rpx !important;
  line-height: 88rpx !important;
  font-size: 30rpx !important;
  font-weight: 600 !important;
}

.submit-btn:active {
  opacity: 0.88;
}
