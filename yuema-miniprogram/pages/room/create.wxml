<page-meta root-background-color="{{themeMeta.rootBg}}" background-color="{{themeMeta.bg}}" background-color-bottom="{{themeMeta.bgBottom}}" background-text-style="{{themeMeta.textStyle}}" />
<view class="{{themeScopeClass}}">
<view class="container">
  <view class="form-container">
    <view class="form-item">
      <text class="label">玩法选择</text>
      <picker bindchange="onGameTypeChange" value="{{gameTypeIndex}}" range="{{gameTypes}}" range-key="name">
        <view class="picker-value {{gameTypeIndex === -1 ? 'placeholder' : ''}}">
          {{gameTypeIndex === -1 ? '请选择玩法' : gameTypes[gameTypeIndex].name}}
        </view>
      </picker>
    </view>

    <!-- 当前玩法下的预设规则开关（每行 item.checked，避免 checked 绑定对象动态下标导致多开关联动异常） -->
    <block wx:if="{{ruleSwitchRows.length > 0}}">
      <view class="rules-section-title">玩法细则</view>
      <view class="form-item form-item-switch" hover-class="none" wx:for="{{ruleSwitchRows}}" wx:key="key">
        <text class="label">{{item.label}}</text>
        <view class="rule-switch-wrap">
          <switch checked="{{item.checked}}" data-key="{{item.key}}" bindchange="onRuleSwitch" color="#d97757"/>
        </view>
      </view>
      <!-- 四川：加底/加番为单选，写入 ruleBuckets.sichuan.jiaDi、jiaFan -->
      <view wx:if="{{currentGameTypeId === 'sichuan'}}" class="form-item form-item-jia-radio">
        <text class="label">加底 / 加番</text>
        <!-- 不用 radio-group 的 value：低基础库不生效，编辑回填后单选看起来全未选；改为各 radio 显式 checked -->
        <radio-group class="jia-radio-group" bindchange="onSichuanJiaScoreChange">
          <!-- value 须与 utils/gameRuleSets.js 中 SICHUAN_JIA_SCORE_RADIO_NONE 一致 -->
          <label class="jia-radio-item"><radio value="__none__" checked="{{sichuanJiaPick === '__none__'}}" color="#d97757"/>不选</label>
          <label class="jia-radio-item"><radio value="jiaDi" checked="{{sichuanJiaPick === 'jiaDi'}}" color="#d97757"/>加底</label>
          <label class="jia-radio-item"><radio value="jiaFan" checked="{{sichuanJiaPick === 'jiaFan'}}" color="#d97757"/>加番</label>
        </radio-group>
      </view>
      <view class="custom-rules-wrap">
        <text class="custom-rules-hint">自定义规则（每条≤40字，最多5条）</text>
        <view class="custom-line-row" wx:for="{{displayCustomLines}}" wx:key="index" wx:for-index="idx">
          <text class="custom-line-text">{{item}}</text>
          <text class="custom-line-del" data-index="{{idx}}" bindtap="removeCustomLine">删除</text>
        </view>
        <view class="custom-add-block">
          <input
            class="custom-add-input"
            value="{{customLineInput}}"
            maxlength="40"
            bindinput="onCustomLineInput"
            placeholder="补充口头约定，如封顶、坐序"
          />
          <button class="custom-add-btn" bindtap="addCustomLine">添加</button>
        </view>
      </view>
    </block>

    <view class="form-item">
      <text class="label">最大人数</text>
      <picker bindchange="onMaxPlayersChange" value="{{maxPlayersIndex}}" range="{{maxPlayersOptions}}">
        <view class="picker-value">
          {{maxPlayersOptions[maxPlayersIndex]}}人
        </view>
      </picker>
    </view>

    <!-- 计划开始时间窗口 + 预计时长：写入 rooms.start_window_* / duration_minutes -->
    <view class="form-item form-item-column form-item-schedule">
      <text class="label">开始时间（起）</text>
      <view class="schedule-dt-row">
        <picker mode="date" start="{{scheduleMinDate}}" end="2037-12-31" value="{{swBeginDate || swDefaultDate}}" bindchange="onSwBeginDateChange">
          <view class="picker-value schedule-picker-half {{!swBeginDate ? 'placeholder' : ''}}">{{swBeginDate ? swBeginDate : '日期'}}</view>
        </picker>
        <picker mode="time" start="{{swBeginTimePickerStart}}" end="23:59" value="{{swBeginTime || swBeginTimePickerStart}}" bindchange="onSwBeginTimeChange">
          <view class="picker-value schedule-picker-half {{!swBeginTime ? 'placeholder' : ''}}">{{swBeginTime ? swBeginTime : '时间'}}</view>
        </picker>
      </view>
    </view>
    <view class="form-item form-item-column form-item-schedule">
      <text class="label">开始时间（止）</text>
      <view class="schedule-dt-row">
        <picker mode="date" start="{{scheduleMinDate}}" end="2037-12-31" value="{{swEndDate || swDefaultDate}}" bindchange="onSwEndDateChange">
          <view class="picker-value schedule-picker-half {{!swEndDate ? 'placeholder' : ''}}">{{swEndDate ? swEndDate : '日期'}}</view>
        </picker>
        <picker mode="time" start="{{swEndTimePickerStart}}" end="23:59" value="{{swEndTime || swEndTimePickerStart}}" bindchange="onSwEndTimeChange">
          <view class="picker-value schedule-picker-half {{!swEndTime ? 'placeholder' : ''}}">{{swEndTime ? swEndTime : '时间'}}</view>
        </picker>
      </view>
    </view>
    <view class="form-item">
      <text class="label">预计牌局时长</text>
      <picker bindchange="onDurationChange" value="{{durationIndex}}" range="{{durationOptions}}" range-key="label">
        <view class="picker-value">{{durationOptions[durationIndex].label}}</view>
      </picker>
    </view>

    <view class="form-item">
      <text class="label">场地(可选)</text>
      <picker bindchange="onVenueChange" value="{{venueIndex}}" range="{{venues}}" range-key="name">
        <view class="picker-value {{venueIndex === -1 ? 'placeholder' : ''}}">
          {{venueIndex === -1 ? '待定' : venues[venueIndex].name}}
        </view>
      </picker>
    </view>

    <view class="form-item" wx:if="{{venueIndex === -1}}">
      <text class="label">对局位置</text>
      <view class="picker-value {{!selectedLocation ? 'placeholder' : ''}}" bindtap="chooseLocation">
        {{selectedLocation ? selectedLocation.address : '点击选择位置'}}
      </view>
    </view>

    <view class="form-item form-item-column">
      <text class="label">备注</text>
      <textarea class="remark-area" value="{{remark}}" maxlength="255" bindinput="onRemarkInput" placeholder="特殊需求、迟到说明等"/>
    </view>
  </view>

  <view class="btn-area">
    <!-- 编辑模式标题由 onLoad 设置，按钮文案区分创建/保存 -->
    <button class="submit-btn" bindtap="submit">{{editRoomId ? '保存修改' : '创建房间'}}</button>
  </view>
</view>
</view>
