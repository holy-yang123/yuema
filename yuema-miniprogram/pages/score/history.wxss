.container {
  background-color: #faf9f5;
  min-height: 100%;
  padding: 32rpx;
  box-sizing: border-box;
}

.room-info {
  background: #ffffff;
  padding: 32rpx;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 1rpx solid rgba(20, 20, 19, 0.08);
  box-shadow: 0 8rpx 24rpx rgba(20, 20, 19, 0.06);
}

.room-no {
  color: #141413;
  font-size: 30rpx;
  font-weight: 600;
}

.game-type {
  color: #d97757;
  font-size: 26rpx;
  font-weight: 500;
}

.history-item {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(20, 20, 19, 0.08);
  box-shadow: 0 8rpx 24rpx rgba(20, 20, 19, 0.05);
}

.round-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #e8e6dc;
}

.round-no {
  color: #141413;
  font-size: 28rpx;
  font-weight: 600;
}

.round-time {
  color: #b0aea5;
  font-size: 22rpx;
}

.player-scores {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.player-score {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.nickname {
  color: #b0aea5;
  font-size: 26rpx;
}

.score {
  font-size: 28rpx;
  font-weight: 600;
}

.plus {
  color: #788c5d;
}

.minus {
  color: #FF4D4F;
}

.empty-state {
  display: flex;
  justify-content: center;
  padding-top: 160rpx;
  color: #b0aea5;
  font-size: 28rpx;
}
