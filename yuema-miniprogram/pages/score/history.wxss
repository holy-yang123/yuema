.container {
  background-color: #08090A;
  min-height: 100%;
  padding: 32rpx;
  box-sizing: border-box;
}

.room-info {
  background: #101214;
  padding: 32rpx;
  border-radius: 12rpx;
  margin-bottom: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 1rpx solid #1F1F1F;
}

.room-no {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.game-type {
  color: #28E088;
  font-size: 26rpx;
  font-weight: 500;
}

.history-item {
  background: #101214;
  border-radius: 12rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #1F1F1F;
}

.round-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #1F1F1F;
}

.round-no {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}

.round-time {
  color: #4B4B4B;
  font-size: 22rpx;
}

.player-scores {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.player-score {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.nickname {
  color: #8A9096;
  font-size: 26rpx;
}

.score {
  font-size: 28rpx;
  font-weight: 600;
}

.plus {
  color: #28E088;
}

.minus {
  color: #FF4D4F;
}

.empty-state {
  display: flex;
  justify-content: center;
  padding-top: 160rpx;
  color: #4B4B4B;
  font-size: 28rpx;
}
