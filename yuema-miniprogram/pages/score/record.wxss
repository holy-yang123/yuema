.container {
  background-color: #000000;
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: 180rpx;
}

.score-header {
  padding-bottom: 40rpx;
}

.score-round-label {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: -1rpx;
}

.score-header-hint {
  font-size: 24rpx;
  color: #4B4B4B;
}

.card-label {
  font-size: 24rpx;
  color: #8A9096;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  display: block;
  margin-bottom: 24rpx;
}

.type-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.type-chip {
  padding: 16rpx 32rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #8A9096;
  background: #101214;
  border: 1rpx solid #1F1F1F;
  font-weight: 500;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.type-chip.chip-active {
  background: rgba(40, 224, 136, 0.1);
  color: #28E088;
  border-color: #28E088;
}

.player-score-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.player-score-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #101214;
  border: 1rpx solid #1F1F1F;
  border-radius: 8rpx;
}

.player-score-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 8rpx;
  background: #1F1F1F;
  margin-right: 24rpx;
}

.player-score-name {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 500;
}

.score-toggle {
  width: 56rpx;
  height: 56rpx;
  border-radius: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  margin-right: 24rpx;
}

.toggle-positive { background: rgba(40, 224, 136, 0.1); color: #28E088; }
.toggle-negative { background: rgba(255, 77, 79, 0.1); color: #FF4D4F; }

.score-value-input {
  width: 140rpx;
  height: 80rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  background: #000000;
  border-radius: 8rpx;
  border: 1rpx solid #1F1F1F;
}

.validation-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  border-radius: 8rpx;
  margin-top: 24rpx;
}

.validation-bar.valid { background: rgba(40, 224, 136, 0.05); color: #28E088; }
.validation-bar.invalid { background: rgba(255, 77, 79, 0.05); color: #FF4D4F; }

.remark-area {
  width: 100%;
  height: 160rpx;
  padding: 24rpx;
  background: #101214;
  border-radius: 8rpx;
  border: 1rpx solid #1F1F1F;
  color: #ffffff;
  font-size: 28rpx;
  box-sizing: border-box;
}

.template-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  background: #101214;
  color: #8A9096;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 500;
  border: 1rpx solid #1F1F1F;
}

.submit-area {
  padding: 32rpx;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #000000;
  border-top: 1rpx solid #1F1F1F;
  z-index: 100;
}

.submit-btn {
  width: 100%;
  background: #28E088 !important;
  color: #000000 !important;
  border-radius: 8rpx !important;
  height: 88rpx !important;
  line-height: 88rpx !important;
  font-weight: 600 !important;
}
