.container {
  background-color: #faf9f5;
  min-height: 100%;
  padding: 32rpx;
  padding-bottom: 180rpx;
  box-sizing: border-box;
}

.locked-tip {
  font-size: 24rpx;
  color: #b0aea5;
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.modify-entry {
  margin-bottom: 24rpx;
}

.modify-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 200;
}

.modify-modal {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  top: 12vh;
  max-height: 75vh;
  overflow-y: auto;
  background: #ffffff;
  border: 1rpx solid rgba(20, 20, 19, 0.08);
  border-radius: 16rpx;
  padding: 28rpx;
  z-index: 210;
  box-shadow: 0 16rpx 48rpx rgba(20, 20, 19, 0.12);
}

.modify-modal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #141413;
  display: block;
  margin-bottom: 24rpx;
}

.modify-modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.modify-modal-actions .btn {
  flex: 1;
}

.score-header {
  padding-bottom: 40rpx;
}

.score-round-label {
  font-size: 40rpx;
  font-weight: 700;
  color: #141413;
  letter-spacing: -1rpx;
}

.score-header-hint {
  font-size: 24rpx;
  color: #b0aea5;
}

.card-label {
  font-size: 24rpx;
  color: #b0aea5;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  display: block;
  margin-bottom: 24rpx;
}

.type-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.type-chip {
  padding: 16rpx 32rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #b0aea5;
  background: #ffffff;
  border: 1rpx solid #e8e6dc;
  font-weight: 500;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.type-chip.chip-active {
  background: rgba(217, 119, 87, 0.12);
  color: #c45a3d;
  border-color: #d97757;
}

.player-score-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.player-score-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #ffffff;
  border: 1rpx solid #e8e6dc;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(20, 20, 19, 0.04);
}

.player-score-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 8rpx;
  background: #e8e6dc;
  margin-right: 24rpx;
}

.player-score-name {
  font-size: 28rpx;
  color: #141413;
  font-weight: 500;
}

.score-toggle {
  width: 56rpx;
  height: 56rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  margin-right: 24rpx;
}

.toggle-positive { background: rgba(120, 140, 93, 0.15); color: #788c5d; }
.toggle-negative { background: rgba(255, 77, 79, 0.1); color: #FF4D4F; }

.score-value-input {
  width: 140rpx;
  height: 80rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #141413;
  background: #faf9f5;
  border-radius: 10rpx;
  border: 1rpx solid #e8e6dc;
}

.validation-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  border-radius: 10rpx;
  margin-top: 24rpx;
}

.validation-bar.valid { background: rgba(120, 140, 93, 0.08); color: #788c5d; }
.validation-bar.invalid { background: rgba(255, 77, 79, 0.06); color: #FF4D4F; }

.remark-area {
  width: 100%;
  height: 160rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 12rpx;
  border: 1rpx solid #e8e6dc;
  color: #141413;
  font-size: 28rpx;
  box-sizing: border-box;
}

.template-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  background: #faf9f5;
  color: #7a7870;
  border-radius: 10rpx;
  font-size: 26rpx;
  font-weight: 500;
  border: 1rpx solid #e8e6dc;
}

.submit-area {
  padding: 32rpx;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  border-top: 1rpx solid #e8e6dc;
  z-index: 100;
  box-shadow: 0 -8rpx 28rpx rgba(20, 20, 19, 0.06);
}

.submit-btn {
  width: 100%;
  background: linear-gradient(145deg, #e08568 0%, #d97757 100%) !important;
  color: #ffffff !important;
  border-radius: 12rpx !important;
  height: 88rpx !important;
  line-height: 88rpx !important;
  font-weight: 600 !important;
}
