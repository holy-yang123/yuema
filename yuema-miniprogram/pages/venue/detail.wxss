.container {
  background-color: var(--bg);
  min-height: 100%;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

.banner {
  width: 100%;
  height: 500rpx;
  position: relative;
}

.banner image {
  width: 100%;
  height: 100%;
  filter: brightness(1);
}

.info-section {
  padding: 40rpx 32rpx;
  background-color: var(--bg);
}

.venue-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.venue-name {
  color: var(--text);
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
}

.venue-rating {
  color: var(--tag-warning-fg);
  font-size: 28rpx;
  font-weight: 500;
}

.venue-address {
  display: flex;
  justify-content: space-between;
  color: var(--text-secondary);
  font-size: 26rpx;
  margin-bottom: 16rpx;
}

.venue-quick-actions {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.quick-link {
  font-size: 26rpx;
  color: var(--accent-orange);
}

.distance {
  color: var(--accent-green);
  font-weight: 500;
}

.detail-section {
  padding: 40rpx 32rpx;
  background-color: var(--surface-solid);
  border-top: 1rpx solid var(--bg-muted);
}

.section-title {
  color: var(--text);
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  position: relative;
  padding-left: 24rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 4rpx;
  height: 24rpx;
  background: var(--accent-orange);
}

.section-content {
  color: var(--text-secondary);
  font-size: 28rpx;
  line-height: 1.8;
}

.footer-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: var(--surface-solid);
  border-top: 1rpx solid var(--bg-muted);
  z-index: 100;
  box-shadow: 0 -8rpx 28rpx rgba(20, 20, 19, 0.06);
}

.btn-foot {
  flex: 1;
  height: 88rpx !important;
  line-height: 88rpx !important;
  border-radius: 12rpx !important;
  font-size: 28rpx !important;
  font-weight: 600 !important;
  border: none !important;
}

.btn-foot::after {
  border: none;
}

.btn-foot.primary {
  background: linear-gradient(145deg, #e08568 0%, var(--accent-orange) 100%) !important;
  color: var(--btn-primary-text) !important;
}

.btn-foot.secondary {
  background: var(--bg) !important;
  color: var(--text) !important;
  border: 1rpx solid var(--bg-muted) !important;
}
