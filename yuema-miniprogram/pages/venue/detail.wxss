.container {
  background-color: #08090A;
  min-height: 100%;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

.banner {
  width: 100%;
  height: 500rpx;
  position: relative;
}

.banner image {
  width: 100%;
  height: 100%;
  filter: brightness(0.8);
}

.info-section {
  padding: 40rpx 32rpx;
  background-color: #08090A;
}

.venue-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.venue-name {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
}

.venue-rating {
  color: #FFAB00;
  font-size: 28rpx;
  font-weight: 500;
}

.venue-address {
  display: flex;
  justify-content: space-between;
  color: #8A9096;
  font-size: 26rpx;
  margin-bottom: 16rpx;
}

.venue-quick-actions {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.quick-link {
  font-size: 26rpx;
  color: #28e088;
}

.distance {
  color: #28E088;
  font-weight: 500;
}

.detail-section {
  padding: 40rpx 32rpx;
  background-color: #101214;
  border-top: 1rpx solid #1F1F1F;
}

.section-title {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  position: relative;
  padding-left: 24rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 4rpx;
  height: 24rpx;
  background: #28E088;
}

.section-content {
  color: #8A9096;
  font-size: 28rpx;
  line-height: 1.8;
}

.footer-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #000000;
  border-top: 1rpx solid #1F1F1F;
  z-index: 100;
}

.btn-foot {
  flex: 1;
  height: 88rpx !important;
  line-height: 88rpx !important;
  border-radius: 8rpx !important;
  font-size: 28rpx !important;
  font-weight: 600 !important;
  border: none !important;
}

.btn-foot::after {
  border: none;
}

.btn-foot.primary {
  background: #28e088 !important;
  color: #000000 !important;
}

.btn-foot.secondary {
  background: rgba(19, 22, 28, 0.9) !important;
  color: #f4f5f7 !important;
  border: 1rpx solid rgba(255, 255, 255, 0.08) !important;
}
