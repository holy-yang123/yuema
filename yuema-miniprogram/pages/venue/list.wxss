.container {
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
  background-color: #08090A;
  box-sizing: border-box;
}

.header {
  flex-shrink: 0;
  padding: 32rpx;
  background-color: #08090A;
  border-bottom: 1rpx solid #1F1F1F;
}

.search-box {
  display: flex;
  align-items: center;
  background: #1A1D21; /* 稍稍提亮背景 */
  border-radius: 8rpx;
  padding: 16rpx 24rpx;
  border: 1rpx solid #30363D; /* 更有质感的边框 */
}

.search-box input {
  flex: 1;
  margin-left: 20rpx;
  color: #ffffff;
  font-size: 28rpx;
}

.placeholder-style {
  color: #8A9096; /* 提亮占位符 */
}

.venue-list {
  padding: 32rpx;
  width: 100%;
  box-sizing: border-box;
  background-color: #08090A;
}

.venue-card {
  width: 100%;
  background: #101214;
  border-radius: 12rpx;
  margin-bottom: 32rpx;
  overflow: hidden;
  display: flex;
  align-items: center; /* 垂直居中 */
  padding: 24rpx; /* 改为内部 padding */
  border: 1rpx solid #1F1F1F;
  transition: all 0.2s ease;
}

.venue-card:active {
  border-color: #28E088;
  background: #1A1D21;
}

.venue-image {
  width: 160rpx; /* 稍微缩小图片，让排版更精致 */
  height: 160rpx;
  background: #1F1F1F; /* 解决黑洞问题 */
  border-radius: 8rpx;
  flex-shrink: 0;
}

.venue-image image {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.venue-info {
  flex: 1;
  padding-left: 24rpx; /* 改为 padding-left */
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.venue-name {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.venue-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.rating {
  color: #FFAB00;
  font-size: 24rpx;
  font-weight: 500;
}

.price {
  color: #28E088;
  font-size: 26rpx;
  font-weight: 600;
}

.venue-address {
  color: #4B4B4B;
  font-size: 22rpx;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.venue-tags {
  display: flex;
  gap: 12rpx;
}

.tag {
  font-size: 18rpx;
  color: #8A9096;
  background: #1A1D21;
  padding: 4rpx 10rpx;
  border-radius: 4rpx;
  border: 1rpx solid #30363D;
}

.empty-state {
  display: flex;
  justify-content: center;
  padding-top: 160rpx;
  color: #4B4B4B;
  font-size: 28rpx;
}
