.container {
  background-color: #0f0f0f;
  min-height: 100vh;
}

.header {
  padding: 30rpx;
  background-color: #1a1a1a;
}

.search-box {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 40rpx;
  padding: 15rpx 30rpx;
}

.search-box input {
  flex: 1;
  margin-left: 20rpx;
  color: #fff;
  font-size: 28rpx;
}

.placeholder-style {
  color: rgba(255, 255, 255, 0.2);
}

.venue-list {
  padding: 30rpx;
  box-sizing: border-box;
}

.venue-card {
  background: #1a1a1a;
  border-radius: 24rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
  display: flex;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
}

.venue-image {
  width: 220rpx;
  height: 220rpx;
}

.venue-image image {
  width: 100%;
  height: 100%;
}

.venue-info {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
}

.venue-name {
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.venue-meta {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.rating {
  color: #fbbf24;
  font-size: 24rpx;
}

.price {
  color: #a78bfa;
  font-size: 24rpx;
}

.venue-address {
  color: rgba(255, 255, 255, 0.4);
  font-size: 22rpx;
  margin-bottom: 15rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.venue-tags {
  display: flex;
}

.tag {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
  background: rgba(255, 255, 255, 0.05);
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-right: 10rpx;
}

.empty-state {
  display: flex;
  justify-content: center;
  padding-top: 100rpx;
  color: rgba(255, 255, 255, 0.3);
  font-size: 28rpx;
}
