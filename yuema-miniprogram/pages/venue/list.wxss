.container {
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
  background-color: var(--bg);
  box-sizing: border-box;
}

.header {
  flex-shrink: 0;
  padding: 32rpx;
  background-color: var(--bg);
  border-bottom: 1rpx solid var(--bg-muted);
}

.search-box {
  display: flex;
  align-items: center;
  background: var(--surface-solid);
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  border: 1rpx solid rgba(20, 20, 19, 0.08);
  box-shadow: 0 4rpx 16rpx rgba(20, 20, 19, 0.05);
}

.search-box input {
  flex: 1;
  margin-left: 20rpx;
  color: var(--text);
  font-size: 28rpx;
}

.placeholder-style {
  color: var(--text-secondary);
}

.venue-list {
  padding: 32rpx;
  width: 100%;
  box-sizing: border-box;
  background-color: var(--bg);
}

.venue-card {
  width: 100%;
  background: var(--surface-solid);
  border-radius: 16rpx;
  margin-bottom: 32rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  padding: 24rpx;
  border: 1rpx solid rgba(20, 20, 19, 0.08);
  box-shadow: 0 8rpx 28rpx rgba(20, 20, 19, 0.06);
  transition: all 0.2s ease;
}

.venue-card:active {
  border-color: rgba(217, 119, 87, 0.35);
  background: var(--bg-soft);
}

.venue-image {
  width: 160rpx;
  height: 160rpx;
  background: var(--bg-muted);
  border-radius: 12rpx;
  flex-shrink: 0;
}

.venue-image image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.venue-info {
  flex: 1;
  padding-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.venue-name {
  color: var(--text);
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.venue-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.rating {
  color: var(--tag-warning-fg);
  font-size: 24rpx;
  font-weight: 500;
}

.price {
  color: var(--accent-orange);
  font-size: 26rpx;
  font-weight: 600;
}

.venue-address {
  color: var(--text-secondary);
  font-size: 22rpx;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.venue-tags {
  display: flex;
  gap: 12rpx;
}

.tag {
  font-size: 18rpx;
  color: var(--text-secondary);
  background: rgba(232, 230, 220, 0.8);
  padding: 4rpx 10rpx;
  border-radius: 4rpx;
  border: 1rpx solid rgba(20, 20, 19, 0.08);
}

.empty-state {
  display: flex;
  justify-content: center;
  padding-top: 160rpx;
  color: var(--text-secondary);
  font-size: 28rpx;
}
